#CanonicalizeHostname yes
#ServerAliveInterval 4
#ServerAliveCountMax 2

Include ~/.ssh/config.local

Host github.com
    ControlMaster auto
    ControlPersist 30m

Host codeberg.org
    ControlMaster no

Match exec "test -t 0"
    Compression yes

Host *
    Compression no
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 3h
    ServerAliveInterval 11
    ForwardAgent no

Host github.com
    Hostname ssh.github.com
    Port 443
    User git

Host phone
    Port 8022
    User anything

Host localhost
    Hostname localhost
    # to prevent matching below
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Match host *,!*.*
    Hostname %h.curl-amberjack.ts.net
