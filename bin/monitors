#!/bin/bash
#
# Simplified monitor control for KDE Wayland.
#
# The old mons(1) script drove xrandr directly. KWin owns the output
# configuration on Wayland, so this wrapper exposes the operations that are
# actually useful through kscreenctl.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: monitors [command]

Commands:
  (none)                    List connected outputs
  on                        Enable all outputs
  off                       Disable all outputs
  auto, -a                  Enable the only connected output, if there is one
  only OUTPUT [MODE]        Enable only OUTPUT, optionally setting a mode
  extend OUTPUT [SIDE] [FROM]
                            Extend OUTPUT to SIDE (left|right|top|bottom) of
                            FROM (default: first other enabled output)
  mirror OUTPUT [FROM]      Mirror OUTPUT from FROM (default: first other
                            enabled output)
  primary OUTPUT            Make OUTPUT the primary output
  cycle                     Cycle all -> external -> internal -> mirror -> extend
  -v, --verbose             Trace the kscreenctl commands
  -h, --help                Show this help

Examples:
  monitors
  monitors only HDMI-A-1 1920x1080@60
  monitors extend HDMI-A-1 right eDP-1
  monitors mirror HDMI-A-1 eDP-1
EOF
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "monitors: $1 not found" >&2
        exit 127
    }
}

json() {
    kscreenctl list-outputs --json
}

connected_outputs() {
    json | jq -r '.[] | select(.connected) | .name'
}

enabled_outputs() {
    kscreenctl list-outputs --enabled --names
}

output_exists() {
    connected_outputs | grep -qx -- "$1"
}

list_outputs() {
    json | jq -r '
        .[]
        | [
            .name,
            (if .enabled then "on" else "off" end),
            (if .mode != null then
                "\(.mode.resolution.width)x\(.mode.resolution.height)@\(.mode.refreshRate | round)"
             else "-" end),
            ((.scale // 1) | tostring),
            "\(.position.x // 0),\(.position.y // 0)"
          ]
        | @tsv
    ' | {
        printf 'OUTPUT\tSTATE\tMODE\tSCALE\tPOSITION\n'
        cat
    } | column -t -s $'\t'
}

other_enabled() {
    local target=$1
    enabled_outputs | grep -vx -- "$target" | head -n1
}

cmd_on() {
    kscreenctl on
}

cmd_off() {
    kscreenctl off
}

cmd_auto() {
    local outputs
    mapfile -t outputs < <(connected_outputs)
    if [ "${#outputs[@]}" -eq 0 ]; then
        echo "monitors: no connected outputs" >&2
        return 1
    fi
    if [ "${#outputs[@]}" -gt 1 ]; then
        echo "monitors: ${#outputs[@]} outputs connected; not changing anything" >&2
        return 0
    fi
    kscreenctl "${outputs[0]}" set-enabled true
}

cmd_only() {
    local target=${1-}
    local mode=${2-}
    if [ -z "$target" ]; then
        echo "monitors: only requires an output name" >&2
        return 2
    fi
    output_exists "$target" || {
        echo "monitors: unknown output: $target" >&2
        return 2
    }

    kscreenctl "$target" set-enabled true
    if [ -n "$mode" ]; then
        kscreenctl "$target" set-mode "$mode"
    fi

    local output
    while IFS= read -r output; do
        [ "$output" = "$target" ] && continue
        kscreenctl "$output" set-enabled false
    done < <(enabled_outputs)
}

side_arg() {
    case "$1" in
        left) echo left-of ;;
        right) echo right-of ;;
        top | above) echo above ;;
        bottom | below) echo below ;;
        *)
            echo "monitors: unknown side: $1 (use left, right, top, bottom)" >&2
            return 2
            ;;
    esac
}

cmd_extend() {
    local target=${1-}
    local side=${2:-right}
    local from=${3-}
    if [ -z "$target" ]; then
        echo "monitors: extend requires an output name" >&2
        return 2
    fi
    output_exists "$target" || {
        echo "monitors: unknown output: $target" >&2
        return 2
    }
    if [ -z "$from" ]; then
        from=$(other_enabled "$target")
    fi
    if [ -z "$from" ]; then
        echo "monitors: no other enabled output to extend from" >&2
        return 1
    fi
    local position
    position=$(side_arg "$side") || return 2

    kscreenctl "$target" set-enabled true
    kscreenctl "$from" set-enabled true
    kscreenctl "$target" set-replica-of none
    kscreenctl "$target" "$position" "$from"
}

cmd_mirror() {
    local target=${1-}
    local from=${2-}
    if [ -z "$target" ]; then
        echo "monitors: mirror requires an output name" >&2
        return 2
    fi
    output_exists "$target" || {
        echo "monitors: unknown output: $target" >&2
        return 2
    }
    if [ -z "$from" ]; then
        from=$(other_enabled "$target")
    fi
    if [ -z "$from" ]; then
        echo "monitors: no other enabled output to mirror from" >&2
        return 1
    fi

    kscreenctl "$from" set-enabled true
    kscreenctl "$target" set-enabled true
    kscreenctl "$target" set-replica-of "$from"
}

cmd_primary() {
    local target=${1-}
    if [ -z "$target" ]; then
        echo "monitors: primary requires an output name" >&2
        return 2
    fi
    output_exists "$target" || {
        echo "monitors: unknown output: $target" >&2
        return 2
    }
    kscreenctl "$target" set-primary
}

cmd_cycle() {
    local state_file=/tmp/monitor_mode.dat
    local state=all
    [ -f "$state_file" ] && state=$(cat "$state_file")

    local internal external
    internal=$(connected_outputs | grep -E '^(eDP|LVDS|DSI)' | head -n1 || true)
    external=$(connected_outputs | grep -Ev '^(eDP|LVDS|DSI)' | head -n1 || true)

    if [ -z "$internal" ] || [ -z "$external" ]; then
        echo "monitors: cycle needs one internal and one external output" >&2
        return 1
    fi

    case "$state" in
        all)
            state=EXTERNAL
            cmd_only "$external"
            ;;
        EXTERNAL)
            state=INTERNAL
            cmd_only "$internal"
            ;;
        INTERNAL)
            state=CLONES
            cmd_mirror "$external" "$internal"
            ;;
        *)
            state=all
            cmd_extend "$external" right "$internal"
            ;;
    esac
    printf '%s\n' "$state" >"$state_file"
}

main() {
    if [ "${1-}" = -v ] || [ "${1-}" = --verbose ]; then
        set -x
        shift
    fi

    need kscreenctl
    need jq

    case "${1-}" in
        '') list_outputs ;;
        -h | --help | help) usage ;;
        on) cmd_on ;;
        off) cmd_off ;;
        auto | -a) cmd_auto ;;
        only) shift; cmd_only "$@" ;;
        extend) shift; cmd_extend "$@" ;;
        mirror) shift; cmd_mirror "$@" ;;
        primary) shift; cmd_primary "$@" ;;
        cycle) cmd_cycle ;;
        *)
            echo "monitors: unknown command: $1" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
