#!/usr/bin/env python3
"""
Internet Archive Item File Statistics CLI
Usage: python ia_stats.py identifier1 identifier2 identifier3 ...
"""

import argparse
import json
import sys
from collections import defaultdict

from internetarchive import get_item
from tabulate import tabulate


def calculate_stats(values):
    """Calculate min, median, max for a list of values."""
    if not values:
        return None, None, None
    sorted_vals = sorted(values)
    count = len(sorted_vals)
    min_val = sorted_vals[0]
    max_val = sorted_vals[-1]
    # Calculate median
    if count % 2 == 0:
        median = (sorted_vals[count//2 - 1] + sorted_vals[count//2]) / 2
    else:
        median = sorted_vals[count//2]
    return min_val, median, max_val

def format_size(size_bytes):
    """Format size in human-readable format."""
    if size_bytes is None:
        return "N/A"
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if size_bytes < 1024.0:
            return f"{size_bytes:.1f} {unit}"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} PB"

def process_item(identifier, verbose=False):
    """Process a single item and return file statistics by format."""
    try:
        item = get_item(identifier)
        
        # Get the files list from the item
        # Access item metadata properly
        files = item.files if hasattr(item, 'files') else []
        
        # Alternatively, you can use item.metadata.get('files', [])
        if not files:
            return {
                'identifier': identifier,
                'error': 'No files found'
            }
        
        # Aggregate by file format
        stats = defaultdict(lambda: {'sizes': [], 'count': 0})
        
        for file_info in files:
            fmt = file_info.get('format', 'Unknown').lower()
            size = file_info.get('size', 0)
            try:
                size = int(size)
            except (TypeError, ValueError):
                size = 0
            if size > 0:  # Only count files with valid sizes
                stats[fmt]['sizes'].append(size)
                stats[fmt]['count'] += 1
        
        # Calculate statistics for each format
        result = {
            'identifier': identifier,
            'total_files': len(files),
            'formats': {}
        }
        
        for fmt, data in stats.items():
            sizes = data['sizes']
            if sizes:
                min_val, median, max_val = calculate_stats(sizes)
                result['formats'][fmt] = {
                    'count': len(sizes),
                    'min': min_val,
                    'median': median,
                    'max': max_val,
                    'total_size': sum(sizes),
                    'all_sizes': sizes
                }
        
        return result
        
    except Exception as e:
        return {
            'identifier': identifier,
            'error': str(e)
        }

def aggregate_results(results):
    """Aggregate file stats for the same format across all result items."""
    agg = defaultdict(list)
    total_files = 0
    for result in results:
        if 'formats' not in result:
            continue
        total_files += result.get('total_files', 0)
        for fmt, stats in result['formats'].items():
            agg[fmt].extend(stats['all_sizes'])

    formats = {}
    for fmt, sizes in agg.items():
        min_val, median, max_val = calculate_stats(sizes)
        formats[fmt] = {
            'count': len(sizes),
            'min': min_val,
            'median': median,
            'max': max_val,
            'total_size': sum(sizes),
        }
    return total_files, formats


def print_results(results, detailed=False, json_output=False):
    """Print the aggregated results in a formatted way."""
    if json_output:
        print(json.dumps(results, indent=2, default=str))
        return

    errors = [r['error'] for r in results if 'error' in r]
    for err in errors:
        print(f"ERROR: {err}")

    total_files, formats = aggregate_results(results)
    print(f"Total Files: {total_files}")

    if not formats:
        print("No files with valid sizes found")
        return

    # Sort formats by total size (largest first)
    sorted_formats = sorted(
        formats.items(),
        key=lambda x: x[1]['total_size'],
        reverse=True
    )

    headers = ["Format", "Count", "Min", "Median", "Max", "Total"]
    rows = [
        [fmt, stats['count'], format_size(stats['min']),
         format_size(stats['median']), format_size(stats['max']),
         format_size(stats['total_size'])]
        for fmt, stats in sorted_formats
    ]
    print("\nFile Type Statistics:")
    print(tabulate(rows, headers=headers, tablefmt="simple"))

    if detailed:
        headers_d = ["Format", "Count", "Min", "Median", "Max"]
        rows_d = [
            [fmt, stats['count'], f"{stats['min']:,}",
             f"{stats['median']:.1f}", f"{stats['max']:,}"]
            for fmt, stats in sorted_formats
        ]
        print("\nDetailed Statistics (in bytes):")
        print(tabulate(rows_d, headers=headers_d, tablefmt="simple"))

def main():
    parser = argparse.ArgumentParser(
        description='Get file statistics for Internet Archive items by file type',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python ia_stats.py annas_archive_english
  python ia_stats.py LEGOManiaUS-SeptemberOctober1995-Miniland
  python ia_stats.py item1 item2 item3
  python ia_stats.py --detail item1 item2
  python ia_stats.py --json item1 item2 > stats.json
        """
    )
    
    parser.add_argument(
        'identifiers',
        nargs='+',
        help='One or more Internet Archive item identifiers'
    )
    
    parser.add_argument(
        '-d', '--detail',
        action='store_true',
        help='Show detailed statistics in bytes'
    )
    
    parser.add_argument(
        '-j', '--json',
        action='store_true',
        help='Output results in JSON format'
    )
    
    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Show verbose output (progress messages)'
    )
    
    args = parser.parse_args()
    
    # Process all identifiers
    results = []
    total = len(args.identifiers)
    
    for i, identifier in enumerate(args.identifiers, 1):
        if args.verbose:
            print(f"Processing [{i}/{total}]: {identifier}", file=sys.stderr)
        
        result = process_item(identifier, args.verbose)
        results.append(result)
    
    # Print results
    print_results(results, args.detail, args.json)

if __name__ == "__main__":
    main()