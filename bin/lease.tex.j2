\Large\textbf{RESIDENTIAL LEASE AGREEMENT}\normalsize

~< set ns = namespace(n=0) >~

~< if landlord.name or premises.address >~
This Residential Lease Agreement (the \textbf{Agreement}) is entered into as of \textbf{<< lease.date | latex >>} by and between \textbf{<< landlord.name | latex >>} (the \textbf{Landlord}) and \textbf{<< tenant | latex >>} (the \textbf{Tenant}). The parties agree as follows:
~< endif >~

~< if premises >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Premises}
Landlord leases to Tenant the premises located at \textbf{<< premises.address | latex >>} in \textbf{<< premises.city | latex >>}, \textbf{<< premises.state | latex >>} \textbf{<< premises.zip | latex >>} (\textbf{<< premises.county | latex >>}), together with the appliances and fixtures listed in the move-in condition report (the \textbf{Premises}).

~< if premises.description >~
The Premises consist of: << premises.description >>
~< endif >~

~< if premises.condition >~
\textbf{Condition of Premises:} << premises.condition >>
~< endif >~
~< endif >~

~< if term >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Term}
The term of this Agreement shall begin on \textbf{<< term.start_date | latex >>} and end on \textbf{<< term.end_date | latex >>}~< if term.length_months >~, a period of \textbf{<< term.length_months | latex >>} months~< endif >~ (the \textbf{Term}). This is a fixed-term lease. Upon expiration, absent renewal, Tenant shall vacate the Premises. Occupation past the end of the Term, or any holdover for any period, creates a month-to-month tenancy terminable by either party upon thirty (30) days written notice; rent during any holdover shall be one and one-half (1.5) times the monthly rent, to the extent permitted by law.
~< endif >~

~< if rent >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Rent}
<< rent >>
\textbf{Base monthly rent:} << rent_amount >>

\textbf{Rent schedule:} The initial partial period from \textbf{<< rent_schedule.first.start | latex >>} through \textbf{<< rent_schedule.first.end | latex >>} is << rent_schedule.first.amount >>. The regular monthly periods are due on the first day of each calendar month at << rent_amount >>~< if rent_schedule.regular >~, for << rent_schedule.regular | length >> full calendar months~< endif >~. The final partial period from \textbf{<< rent_schedule.last.start | latex >>} through \textbf{<< rent_schedule.last.end | latex >>} is << rent_schedule.last.amount >>. No additional full-month rent is due for a period outside the Term.
~< endif >~

~< if deposit >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Deposit and Fees}
<< deposit >>
~< endif >~

~< if utilities >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Utilities and Services}
<< utilities >>
~< endif >~

~< if late_fees >~
