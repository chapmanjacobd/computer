#!/usr/bin/fish

# Clipboard helper.
#
# Normally reads/writes the local Wayland/X clipboard. When the command was
# invoked from a remote terminal (SSH), writes go out as OSC 52 instead, so the
# text lands in the clipboard of the device that ran the command rather than in
# this machine's graphical clipboard; reads are pulled back by asking that
# device's own cb over ssh.

# pid of the tmux client that most recently sent input, among the clients
# attached to the session containing this pane. That is the terminal that
# pressed Enter for this command.
function _cb_client_pid
    set -l session (tmux display-message -p -t $TMUX_PANE '#{session_id}' 2>/dev/null)
    test -n "$session"; or return 1
    set -l pid (tmux list-clients -t $session -F '#{client_activity} #{client_pid}' 2>/dev/null |
        sort -k1,1nr | head -n1 | awk '{ print $2 }')
    test -n "$pid"; or return 1
    echo $pid
end

# Environment of the terminal that invoked this command, or our own if this is
# not running under tmux.
function _cb_client_environ
    if set -q TMUX
        set -l client_pid (_cb_client_pid 2>/dev/null)
        test -n "$client_pid"; or return 1
        tr '\0' '\n' < /proc/$client_pid/environ 2>/dev/null
    else
        env
    end
end

function _cb_client_var --argument-names name
    set -l line (_cb_client_environ | string match -r "^$name=.*" | head -n1)
    test -n "$line"; or return 1
    string replace -- "$name=" '' $line
end

function _cb_client_ip
    set -l ip (_cb_client_var SSH_CLIENT 2>/dev/null | string split ' ' | head -n1)
    test -n "$ip"; or return 1
    echo $ip
end

# A connection from this host to itself (ssh localhost, ssh pakon) is still a
# local terminal, not a remote device.
function _cb_self_client
    set -l ip (_cb_client_ip 2>/dev/null)
    test -n "$ip"; or return 1
    string match -q '127.*' -- $ip; and return 0
    test "$ip" = '::1'; and return 0
    contains -- $ip (hostname -I 2>/dev/null | string split ' ')
end

function _cb_remote_terminal
    # The reverse SSH callback must read this host's clipboard rather than
    # trying to follow the SSH connection back to the original terminal.
    set -q CB_LOCAL_ONLY; and return 1
    _cb_client_ip >/dev/null; or return 1
    not _cb_self_client
end

# Host to ask for the clipboard: the tailnet name of the client address, so
# that per-host ssh config (port, user, key) applies; the bare address when
# the client is not a tailnet node.
function _cb_client_host
    set -l ip (_cb_client_ip 2>/dev/null)
    test -n "$ip"; or return 1
    set -l name (tailscale status 2>/dev/null | awk -v ip=$ip '$1 == ip { print $2; exit }')
    test -n "$name"; and echo $name; or echo $ip
end

# OSC 52 to the terminal (write-only). Termux, kitty, foot, wezterm etc. put the
# text into the device's clipboard; tmux needs `set-clipboard on` to pass it on.
function _cb_osc52 --argument-names file
    printf '\e]52;c;%s\a' (base64 -w0 < $file)
end

# -r/--get forces the read path. Needed when cb is run over ssh (`ssh host cb
# -r`), where stdin is never a terminal and the write path would otherwise
# clobber that machine's clipboard.
set -l get 0
if test (count $argv) -gt 0
    string match -qr '^(-r|--get)$' -- $argv; and set get 1
    set argv (string match -v -r '^(-r|--get)$' -- $argv)
end

set -l mime_type
if test (count $argv) -gt 0
    switch $argv[1]
        case -t --type
            if test (count $argv) -lt 2
                echo 'cb: --type requires a MIME type' >&2
                exit 2
            end
            set mime_type $argv[2]
            set -e argv[1..2]
    end
end

if test -t 0; or test $get = 1
    if test -z "$argv"; and test -z "$mime_type"
        if _cb_remote_terminal
            set -l host (_cb_client_host)
            test -n "$host"; or begin
                echo 'cb: cannot tell which host this terminal came from' >&2
                exit 1
            end
            set -l text (ssh -T -o BatchMode=yes -o ConnectTimeout=5 $host 'env CB_LOCAL_ONLY=1 cb -r' 2>/dev/null)
            if test $status -ne 0
                echo "cb: could not read the clipboard from $host" >&2
                exit 1
            end
            printf '%s' "$text"
        else if test -n "$WAYLAND_DISPLAY"
            wl-paste --no-newline
        else
            xsel --clipboard --output
        end
    else  # allow cb --type text/html usage, etc
        if test -n "$WAYLAND_DISPLAY"
            if test -n "$mime_type"
                wl-paste --no-newline --type $mime_type $argv
            else
                wl-paste --no-newline $argv
            end
        else if test -n "$mime_type"
            xclip -sel c -o -t $mime_type $argv
        else
            xclip -sel c -o $argv
        end
    end
else
    set tmp (mktemp)
    cat > $tmp
    if _cb_remote_terminal
        _cb_osc52 $tmp
    else if test -n "$WAYLAND_DISPLAY"
        wl-copy < $tmp
    else
        xsel --clipboard --input < $tmp
    end
    rm -f $tmp
end
