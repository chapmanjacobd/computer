#!/usr/bin/fish

# Clipboard helper.
#
# Normally reads/writes the local Wayland/X clipboard. When the command was
# invoked from a remote terminal (SSH, e.g. Termux on a phone), writes go out
# as OSC 52 instead, so the text lands in the clipboard of the device that ran
# the command rather than in this machine's graphical clipboard. Reads from the
# phone are pulled back over ssh.

# pid of the tmux client that most recently sent input, among the clients
# attached to the session containing this pane. That is the terminal that
# pressed Enter for this command.
function _cb_client_pid
    set -l session (tmux display-message -p -t $TMUX_PANE '#{session_id}' 2>/dev/null)
    test -n "$session"; or return 1
    set -l pid (tmux list-clients -t $session -F '#{client_activity} #{client_pid}' 2>/dev/null |
        sort -k1,1nr | head -n1 | awk '{ print $2 }')
    test -n "$pid"; or return 1
    echo $pid
end

# Environment of the terminal that invoked this command, or our own if this is
# not running under tmux.
function _cb_client_environ
    if set -q TMUX
        set -l client_pid (_cb_client_pid 2>/dev/null)
        test -n "$client_pid"; or return 1
        tr '\0' '\n' < /proc/$client_pid/environ 2>/dev/null
    else
        env
    end
end

function _cb_client_var --argument-names name
    set -l line (_cb_client_environ | string match -r "^$name=.*" | head -n1)
    test -n "$line"; or return 1
    string replace -- "$name=" '' $line
end

function _cb_client_ip
    set -l ip (_cb_client_var SSH_CLIENT 2>/dev/null | string split ' ' | head -n1)
    test -n "$ip"; or return 1
    echo $ip
end

# A connection from this host to itself (ssh localhost, ssh pakon) is still a
# local terminal, not a remote device.
function _cb_self_client
    set -l ip (_cb_client_ip 2>/dev/null)
    test -n "$ip"; or return 1
    string match -q '127.*' -- $ip; and return 0
    test "$ip" = '::1'; and return 0
    contains -- $ip (hostname -I 2>/dev/null | string split ' ')
end

function _cb_remote_terminal
    _cb_client_ip >/dev/null; or return 1
    not _cb_self_client
end

# The phone is the SSH client whose address is the tailnet address of `phone`.
function _cb_phone_client
    set -l ip (_cb_client_ip 2>/dev/null)
    test -n "$ip"; or return 1
    tailscale status 2>/dev/null | awk '$2 == "phone" { print $1 }' | grep -qx -- "$ip"
end

# OSC 52 to the terminal (write-only). Termux, kitty, foot, wezterm etc. put the
# text into the device's clipboard; tmux needs `set-clipboard on` to pass it on.
function _cb_osc52 --argument-names file
    printf '\e]52;c;%s\a' (base64 -w0 < $file)
end

if test -t 0
    if test -z "$argv"
        if _cb_remote_terminal
            if not _cb_phone_client
                echo 'cb: cannot read the clipboard of this remote terminal; paste in the terminal instead' >&2
                exit 1
            end
            set -l text (ssh -T -o BatchMode=yes -o ConnectTimeout=5 phone termux-clipboard-get 2>/dev/null)
            if test $status -ne 0
                echo 'cb: could not read the phone clipboard (is sshd running on it?)' >&2
                exit 1
            end
            printf '%s' "$text"
        else if test -n "$WAYLAND_DISPLAY"
            wl-paste --no-newline
        else
            xsel --clipboard --output
        end
    else  # allow cb -t text/html usage, etc
        xclip -sel c -o $argv
    end
else
    set tmp (mktemp)
    cat > $tmp
    if _cb_remote_terminal
        _cb_osc52 $tmp
    else if test -n "$WAYLAND_DISPLAY"
        wl-copy < $tmp
    else
        xsel --clipboard --input < $tmp
    end
    rm -f $tmp
end
