~< endif >~

~< if payment >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Payment Terms}
Payment shall be a \textbf{<< payment.basis | default("flat fee", true) | latex >>}~< if payment.rate >~ of \textbf{\$<< "%.2f"|format(payment.rate) >>}~< if payment.ongoing >~ on an ongoing basis~< endif >~~< endif >~.~< if payment.total_fee >~ The total fee for the full term of this Agreement is \textbf{\$<< "%.2f"|format(payment.total_fee) >>}.~< endif >~~< if payment.due_upon >~ Invoices are issued upon \textbf{<< payment.due_upon | latex >>}~< if payment.invoice_terms >~ and are due \textbf{<< payment.invoice_terms | latex >>}~< endif >~.~< elif payment.invoice_terms >~ Invoices are due \textbf{<< payment.invoice_terms | latex >>}.~< endif >~ Payment will be made by \textbf{<< payment.method | default("bank transfer", true) | latex >>} unless otherwise agreed in writing.
~< endif >~

~< if independent >~
~< set ns.n = ns.n + 1 >~
\section*{<< ns.n >>. Independent Contractor Status}
The Contractor is an independent contractor, not an employee of the Client. The Contractor is solely responsible for paying all applicable federal, state, and local taxes, including self-employment tax, and receives no employee benefits such as health insurance, retirement contributions, paid leave, or workers' compensation. Neither party has authority to bind the other, and the Contractor controls the means and manner of performing the work.
~< endif >~

