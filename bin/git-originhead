#!/usr/bin/env bash
# Print the origin default branch's commit SHA, resolved like zg.
set -euo pipefail

default_branch() {
    local ref candidate init
    ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || true
    if [[ -n $ref ]]; then
        echo "${ref#origin/}"
        return 0
    fi

    for candidate in main master; do
        if git show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
            echo "$candidate"
            return 0
        fi
    done

    for candidate in main master; do
        if git show-ref --verify --quiet "refs/heads/$candidate"; then
            echo "$candidate"
            return 0
        fi
    done

    init=$(git config --get init.defaultBranch 2>/dev/null) || true
    if [[ -n $init ]] && git show-ref --verify --quiet "refs/heads/$init"; then
        echo "$init"
        return 0
    fi

    git symbolic-ref --quiet --short HEAD 2>/dev/null || return 1
}

branch=$(default_branch) || branch=''
if [[ -z $branch ]]; then
    echo "git origin-head: could not determine the default branch" >&2
    exit 1
fi

if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git rev-parse --verify "refs/remotes/origin/$branch"
elif git show-ref --verify --quiet "refs/heads/$branch"; then
    git rev-parse --verify "refs/heads/$branch"
else
    echo "git origin-head: default branch '$branch' has no origin or local ref" >&2
    exit 1
fi
