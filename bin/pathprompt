#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path


def get_history_file(namespace: str) -> str:
    state_home = os.environ.get("XDG_STATE_HOME")
    if state_home:
        base_dir = Path(state_home)
    else:
        base_dir = Path.home() / ".local" / "state"

    hist_dir = base_dir / "path_prompter"
    hist_dir.mkdir(parents=True, exist_ok=True)
    return str(hist_dir / f"{namespace}_history")


def main() -> None:
    namespace = sys.argv[1] if len(sys.argv) > 1 else "default"
    last_dest = sys.argv[2] if len(sys.argv) > 2 else ""

    hist_file = get_history_file(namespace)

    try:
        command = [
            "fzf",
            "--walker=file,dir,hidden",
            "--history",
            hist_file,
            "--history-size=1000",
            "--height=40%",
            "--layout=reverse",
            "--border",
            "--prompt=PATH> ",
            "--bind=ctrl-r:prev-history",
        ]
        if last_dest:
            command.extend(["--query", last_dest])

        result = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            text=True,
        )
    except FileNotFoundError as error:
        raise SystemExit("pathprompt requires fzf to be installed and on PATH") from error

    if result.returncode == 0:
        print(result.stdout.rstrip("\n"))
    elif result.returncode in (1, 130):
        print("q")
    else:
        raise SystemExit(f"fzf exited with status {result.returncode}")


if __name__ == "__main__":
    main()
