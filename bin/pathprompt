#!/usr/bin/env python3
import os
import sys
from pathlib import Path


def get_completion_paths() -> list[str]:
    paths = []
    for root, directories, files in os.walk("."):
        for name in (*directories, *files):
            path = os.path.normpath(os.path.join(root, name))
            if os.path.isdir(path):
                path += os.sep
            paths.append(path)
    return paths


def set_readline_completion(list_: list[str]) -> None:
    try:
        import readline
    except ModuleNotFoundError:
        return

    def list_completer(_text: str, state: int) -> str | None:
        line = readline.get_line_buffer()
        match_list = [
            path for path in list_ if path.startswith(line) and path != line
        ]
        if not match_list:
            return None

        if line:
            min_depth = min(path.count(os.sep) for path in match_list) + 1
            match_list = [
                path for path in match_list if path.count(os.sep) <= min_depth
            ][:15]
        else:
            min_depth = min(path.count(os.sep) for path in match_list) + 1
            match_list = [
                path for path in match_list if path.count(os.sep) <= min_depth
            ][:25]

        return match_list[state] if state < len(match_list) else None

    readline.set_completer(list_completer)
    readline.set_completer_delims("\t")
    readline.parse_and_bind("tab: complete")


def get_history_file(namespace: str) -> str:
    state_home = os.environ.get("XDG_STATE_HOME")
    if state_home:
        base_dir = Path(state_home)
    else:
        base_dir = Path.home() / ".local" / "state"

    hist_dir = base_dir / "path_prompter"
    hist_dir.mkdir(parents=True, exist_ok=True)
    return str(hist_dir / f"{namespace}_history")


def main() -> None:
    namespace = sys.argv[1] if len(sys.argv) > 1 else "default"
    last_dest = sys.argv[2] if len(sys.argv) > 2 else ""

    hist_file = get_history_file(namespace)

    # Configure readline
    set_readline_completion(get_completion_paths())
    try:
        import readline
        readline.read_history_file(hist_file)
    except FileNotFoundError:
        pass

    # Pre-fill input if last_dest is provided
    if last_dest:
        import readline

        def startup_hook():
            readline.insert_text(last_dest)
            readline.redisplay()

        readline.set_startup_hook(startup_hook)

    prompt_msg = "PATH>"

    try:
        user_input = input(prompt_msg).strip()
        print(user_input)
    except (KeyboardInterrupt, EOFError):
        print("\nq")
    finally:
        try:
            # We want to clear the startup hook just in case, though we exit right after
            import readline

            readline.set_startup_hook(None)
            # Save the new history, overriding the max if needed
            readline.set_history_length(1000)
            readline.write_history_file(hist_file)
        except OSError:
            pass


if __name__ == "__main__":
    main()
