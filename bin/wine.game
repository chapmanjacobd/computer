#!/usr/bin/env python3
"""wine.game - run a Windows game with the environment its launcher would use.

Usage:
    wine.game [options] <game.exe> [game arguments...]

An executable path may be abbreviated to a bare executable name or a substring
of the game title/store/path (for example "sleeper") as long as exactly one
installed game matches; otherwise the candidates are listed.

The launcher environment is inferred from the executable path:

  * Heroic Games Launcher (Epic/GOG/Amazon/Zoom/sideload) - prefix, Proton or
    Wine runner, environment variables, fps/HDR/Wayland/esync settings and
    wrapper commands from GamesConfig/<app>.json.
  * Lutris - prefix, Wine runner version, WINEDLLOVERRIDES, system.env and
    prefix_command from the per-game YAML in ~/.config/lutris/games.  Proton
    runner versions are started through umu-run when it is installed.
  * Neither - system Wine, with the prefix inferred from a /drive_c/ path when
    possible (otherwise Wine's own default).

In every case the program is started under gamemoderun (disable with
--no-gamemode).  Extra arguments after the executable are passed to the game.
With --rm the matched Heroic game is uninstalled and hidden from Heroic's
library instead of being started.

Options:
    -l, --list [PATTERN] list known Heroic/Lutris games (optionally filtered)
    -n, --dry-run       print the environment and command instead of running
    -q, --quiet         do not print the inferred launcher/prefix
        --rm            uninstall the matched Heroic game and hide it in Heroic
                        (keeps the Wine prefix and per-game settings)
        --remove-prefix with --rm, also delete the game's Wine prefix
        --remove-settings with --rm, also delete the game's Heroic settings and logs
        --no-gamemode   do not wrap the command in gamemoderun
        --no-umu        use Proton's wine binary instead of umu-run for Lutris games
        --prefix PATH   force WINEPREFIX / STEAM_COMPAT_DATA_PATH
        --wine PATH     use this wine binary instead of the inferred runner
        --proton PATH   use this proton script instead of the inferred runner
    -h, --help          show this help
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import shlex
import shutil
import sqlite3
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from string import Template
from typing import NoReturn

try:
    import yaml
except ImportError:  # pragma: no cover - Fedora python3-pyyaml is normally present
    yaml = None

HOME = Path.home()
HEROIC_DIR = Path(os.environ.get("HEROIC_CONFIG_HOME", HOME / ".config" / "heroic"))
LUTRIS_CONFIG = Path(os.environ.get("LUTRIS_CONFIG_HOME", HOME / ".config" / "lutris"))
LUTRIS_DATA = Path(os.environ.get("LUTRIS_DATA_HOME", HOME / ".local" / "share" / "lutris"))
GAMEMODERUN = shutil.which("gamemoderun")
UMU_RUN = shutil.which("umu-run")
LUTRIS_UMU_GAMES = LUTRIS_DATA / "umu-games" / "umu-games.json"

HEROIC_STORE_INSTALLED = {
    "epic": HEROIC_DIR / "legendaryConfig" / "legendary" / "installed.json",
    "gog": HEROIC_DIR / "gog_store" / "installed.json",
    "amazon": HEROIC_DIR / "nile_config" / "nile" / "installed.json",
    "zoom": HEROIC_DIR / "zoom_store" / "installed.json",
    "sideload": HEROIC_DIR / "sideload_apps" / "library.json",
}
HEROIC_STORE_LIBRARY = {
    "amazon": HEROIC_DIR / "nile_config" / "nile" / "library.json",
}
HEROIC_HIDDEN_CONFIG = HEROIC_DIR / "store" / "config.json"


def die(message: str) -> NoReturn:
    print(f"wine.game: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_json(path: Path):
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def load_yaml(path: Path):
    if yaml is None or not path.is_file():
        return None
    try:
        with path.open(encoding="utf-8") as handle:
            data = yaml.safe_load(handle)
    except (OSError, yaml.YAMLError):
        return None
    return data if isinstance(data, dict) else None


def save_json(path: Path, data) -> None:
    """Write JSON in the style of the file being replaced."""
    if path.is_symlink():
        path = path.resolve()
    try:
        existing = path.read_text(encoding="utf-8")
    except OSError:
        existing = ""
    indent = "\t" if existing.startswith(("{\n\t", "[\n\t")) else 2
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.wine.game.tmp")
    try:
        with temporary.open("w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=indent, ensure_ascii=False)
            if existing.endswith("\n"):
                handle.write("\n")
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def env_set(env: dict[str, str], key: str, value) -> None:
    """Set a variable, replacing any differently-cased spelling."""
    for existing in [k for k in env if k.upper() == key.upper()]:
        del env[existing]
    env[key] = str(value)


def env_get(env: dict[str, str], key: str, default=None):
    for existing, value in env.items():
        if existing.upper() == key.upper():
            return value
    return default


HEROIC_STORE_NAMES = {
    "epic": "egs",
    "gog": "gog",
    "amazon": "amazon",
    "zoom": "zoomplatform",
    "sideload": "none",
}


def set_proton_game_id(env: dict[str, str], store: str | None = None) -> None:
    """Give Proton the identifiers protonfixes needs for non-Steam games.

    SteamAppId is enough: protonfixes' get_game_id uses it first, and a
    digit-less prefix path would otherwise make it raise IndexError.

    Do not set SteamGameId. Proton treats that as a Steam launch and loads
    lsteamclient, which asserts when no Steam client is installed (Citizen
    Sleeper from Epic exits with code 3 when it is set).
    """
    env_set(env, "STEAM_COMPAT_APP_ID", env_get(env, "STEAM_COMPAT_APP_ID", "0"))
    env_set(env, "SteamAppId", env_get(env, "SteamAppId", "0"))
    if store:
        env_set(env, "STORE", env_get(env, "STORE", HEROIC_STORE_NAMES.get(store, "none")))


def expand(value, extra: dict[str, str] | None = None) -> str:
    """Expand ~ and $VAR / ${VAR} the way Lutris and Heroic do for settings."""
    mapping = dict(os.environ)
    mapping.setdefault("USER", os.environ.get("LOGNAME", ""))
    mapping.setdefault("HOME", str(HOME))
    if extra:
        mapping.update(extra)
    text = Template(str(value)).safe_substitute(mapping)
    return os.path.expanduser(text)


def under(path: str | None, root: str | None) -> bool:
    if not path or not root:
        return False
    try:
        return os.path.commonpath(
            [os.path.realpath(path), os.path.realpath(root)]
        ) == os.path.realpath(root)
    except ValueError:
        return False


def same_path(left: str | None, right: str | None) -> bool:
    if not left or not right:
        return False
    return os.path.realpath(left) == os.path.realpath(right)


def normalize_exe(exe, base: str | None) -> str | None:
    """Turn a launcher's executable field into an absolute Linux path."""
    if not exe:
        return None
    text = str(exe).replace("\\", "/")
    # Several Heroic entries store paths like "/Binaries/Win64/Game.exe";
    # only treat it as absolute when it really exists.
    if text.startswith("/") and not os.path.exists(text):
        text = text.lstrip("/")
    candidate = Path(text)
    if candidate.is_absolute():
        return str(candidate)
    if base:
        return str(Path(base) / candidate)
    return str(candidate)


def normalized_abs(value: str | None, base: str | None = None) -> str | None:
    if not value:
        return None
    path = Path(expand(value, {"GAMEDIR": base or ""}))
    if not path.is_absolute() and base:
        path = Path(base) / path
    return str(path)


# --------------------------------------------------------------------------
# Launch description
# --------------------------------------------------------------------------


@dataclass
class Launch:
    source: str
    label: str
    kind: str  # proton | umu | wine | native
    runner: str
    prefix: str | None
    workdir: str
    env: dict[str, str] = field(default_factory=dict)
    wrappers: list[list[str]] = field(default_factory=list)
    args: list[str] = field(default_factory=list)
    score: tuple[int, int] = (0, 0)
    notes: list[str] = field(default_factory=list)
    store: str = ""
    title: str = ""
    runner_label: str = ""
    game_exe: str | None = None
    install_dir: str | None = None
    proton_dir: str | None = None
    store_service: str = ""
    service_id: str = ""
    app_name: str = ""

    def command(self, exe: str, passthrough: list[str], gamemode: bool) -> list[str]:
        cmd: list[str] = []
        wrapper_names = {os.path.basename(wrapper[0]) for wrapper in self.wrappers if wrapper}
        if gamemode and GAMEMODERUN and "gamemoderun" not in wrapper_names:
            cmd.append(GAMEMODERUN)
        for wrapper in self.wrappers:
            cmd.extend(wrapper)
        if self.kind in ("proton", "umu"):
            cmd.extend([self.runner, "waitforexitandrun", exe])
        elif self.kind == "native":
            cmd.append(exe)
        else:
            cmd.extend([self.runner, exe])
        cmd.extend(self.args)
        cmd.extend(passthrough)
        return cmd

    def full_env(self) -> dict[str, str]:
        env = dict(os.environ)
        for key, value in self.env.items():
            env_set(env, key, value)
        return env


def system_wine() -> str | None:
    return shutil.which("wine")


def steam_install_path() -> str:
    settings = heroic_settings()
    return (
        settings.get("defaultSteamPath")
        or str(HOME / ".local" / "share" / ".steam" / "steam")
    )


def proton_data_path(prefix: str) -> str:
    """Proton wants the directory containing pfx, not the prefix itself."""
    path = Path(prefix)
    return str(path.parent) if path.name == "pfx" else str(path)


def wine_prefix_path(prefix: str) -> str:
    """Plain Wine wants the prefix itself, not the Heroic/Proton data dir."""
    path = Path(prefix)
    nested = path / "pfx"
    return str(nested) if nested.is_dir() else str(path)


def proton_template_dir(runner: str) -> Path:
    """Template directory a Proton runner uses for new prefixes."""
    root = Path(runner).parent
    if platform.machine() == "aarch64" and os.environ.get("PROTON_USE_ARM64", "1") == "1":
        arm = root / "files" / "share" / "default_pfx_arm64"
        if arm.is_dir():
            return arm
    return root / "files" / "share" / "default_pfx"


def repair_proton_template(runner: str) -> None:
    """Rebuild an incomplete Proton prefix template, or stop with a reason."""
    template = proton_template_dir(runner)
    sentinel = template / "drive_c/windows/system32/nvcuda.dll"
    if sentinel.is_file():
        return

    helper = shutil.which("proton.repair")
    if not helper:
        sibling = Path(__file__).resolve().with_name("proton.repair")
        helper = str(sibling) if os.access(sibling, os.X_OK) else None
    if not helper:
        die(f"{sentinel} is missing and proton.repair was not found; reinstall the Proton build")

    print(f"wine.game: {sentinel} is missing; repairing {Path(runner).parent}", file=sys.stderr)
    try:
        subprocess.run([helper, str(Path(runner).parent)], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        die(f"proton.repair failed: {error}")
    if not sentinel.is_file():
        die(f"{sentinel} is still missing; reinstall the Proton build")


def usable_runner(wine) -> bool:
    if not isinstance(wine, dict) or not wine.get("bin"):
        return False
    binary = str(wine["bin"])
    return os.path.isfile(binary) or shutil.which(binary) is not None


def lutris_runner_root(version: str | None) -> Path | None:
    if not version:
        return None
    root = LUTRIS_DATA / "runners" / "wine" / version
    return root if root.is_dir() else None


def lutris_proton_dir(version: str | None) -> str | None:
    """Return the Proton build root for a Lutris wine version, if it is one."""
    root = lutris_runner_root(version)
    if root and (root / "proton").is_file():
        return str(root)
    return None


def runner_bin_from_version(version: str | None) -> str | None:
    root = lutris_runner_root(version)
    if not root:
        return None
    for rel in ("bin/wine", "files/bin/wine", "bin-wow64/wine"):
        candidate = root / rel
        if candidate.is_file():
            return str(candidate)
    return None


def lutris_umu_id(service: str | None, appid: str | None) -> str:
    """Mirror Lutris's GAMEID lookup in its umu-games database."""
    data = load_json(LUTRIS_UMU_GAMES)
    if not service or not appid or not isinstance(data, list):
        return "umu-default"
    service = str(service).lower()
    if service == "humblebundle":
        service = "humble"
    for entry in data:
        if not isinstance(entry, dict):
            continue
        if (
            str(entry.get("store") or "").lower() == service
            and str(entry.get("appid")) == str(appid)
        ):
            return str(entry.get("umu_id") or "umu-default")
    return "umu-default"


def heroic_settings() -> dict:
    data = load_json(HEROIC_DIR / "store" / "config.json") or {}
    settings = data.get("settings") if isinstance(data, dict) else None
    return settings if isinstance(settings, dict) else {}


# --------------------------------------------------------------------------
# Heroic
# --------------------------------------------------------------------------


def heroic_app_name(record: dict) -> str | None:
    value = record.get("app_name") or record.get("appName") or record.get("id")
    return str(value) if value else None


def heroic_records(data, key: str) -> list[dict]:
    """Return game records from an electron-store file or its older layout."""
    if isinstance(data, dict):
        records = data.get(key)
        if isinstance(records, list):
            return [record for record in records if isinstance(record, dict)]
        # Older Heroic versions stored app_name -> record directly.
        return [
            dict(record, app_name=record.get("app_name") or record.get("appName") or name)
            for name, record in data.items()
            if isinstance(record, dict)
        ]
    if isinstance(data, list):
        return [record for record in data if isinstance(record, dict)]
    return []


def heroic_amazon_details() -> dict[str, dict]:
    """Map Amazon app ids to the library records that carry their titles."""
    library = load_json(HEROIC_STORE_LIBRARY["amazon"])
    details: dict[str, dict] = {}
    if isinstance(library, list):
        for item in library:
            if not isinstance(item, dict):
                continue
            product = item.get("product") if isinstance(item.get("product"), dict) else item
            app_name = heroic_app_name(product)
            if app_name:
                details[app_name] = product
    return details


def heroic_entries():
    """Yield (store, app_name, game_info) for installed Heroic games."""
    epic = load_json(HEROIC_STORE_INSTALLED["epic"])
    if isinstance(epic, dict):
        for app_name, info in epic.items():
            if app_name and isinstance(info, dict):
                yield "epic", str(app_name), info

    for store in ("gog", "zoom"):
        data = load_json(HEROIC_STORE_INSTALLED[store])
        for record in heroic_records(data, "installed"):
            app_name = heroic_app_name(record)
            if app_name:
                yield store, app_name, record

    amazon = load_json(HEROIC_STORE_INSTALLED["amazon"])
    amazon_details = heroic_amazon_details()
    for record in heroic_records(amazon, "installed"):
        app_name = heroic_app_name(record)
        if not app_name:
            continue
        detail = amazon_details.get(app_name, {})
        product = detail.get("productDetail") if isinstance(detail.get("productDetail"), dict) else {}
        info = dict(record)
        info["app_name"] = app_name
        info["title"] = info.get("title") or detail.get("title") or product.get("title")
        install = info.get("install") if isinstance(info.get("install"), dict) else {}
        install.setdefault("install_path", record.get("path"))
        info["install"] = install
        yield "amazon", app_name, info

    sideload = load_json(HEROIC_STORE_INSTALLED["sideload"])
    for record in heroic_records(sideload, "games"):
        app_name = heroic_app_name(record)
        if app_name:
            yield "sideload", app_name, record


def heroic_install_info(info: dict, settings: dict):
    """Return (install_dir, absolute_exe) for a Heroic game info record."""
    install = info.get("install") if isinstance(info.get("install"), dict) else {}
    install_dir = info.get("install_path") or install.get("install_path")
    default_install = settings.get("defaultInstallPath")

    if not install_dir:
        folder = info.get("folder_name")
        if folder:
            folder = str(folder)
            install_dir = folder if os.path.isabs(folder) else os.path.join(default_install or "", folder)

    exe = info.get("executable") or install.get("executable")
    if not exe and not install_dir:
        return None, None

    return (
        normalized_abs(install_dir, default_install),
        normalize_exe(exe, normalized_abs(install_dir, default_install)),
    )


def heroic_candidates() -> list[Launch]:
    settings = heroic_settings()
    launches: list[Launch] = []

    for store, app_name, info in heroic_entries():
        install_dir, game_exe = heroic_install_info(info, settings)
        if not install_dir and not game_exe:
            continue
        # Entries with no executable are DLCs/stubs unless Heroic has per-game
        # settings for them (which also gives us a usable prefix).
        if not game_exe and not (HEROIC_DIR / "GamesConfig" / f"{app_name}.json").is_file():
            continue

        config_document = load_json(HEROIC_DIR / "GamesConfig" / f"{app_name}.json") or {}
        config = config_document.get(app_name) if isinstance(config_document, dict) else None
        config = config if isinstance(config, dict) else {}

        notes: list[str] = []
        env: dict[str, str] = {}
        wrappers: list[list[str]] = []

        wine = config.get("wineVersion") or settings.get("wineVersion") or {}
        if not usable_runner(wine):
            fallback = settings.get("wineVersion") or {}
            if usable_runner(fallback):
                notes.append(
                    "per-game runner "
                    f"{wine.get('name') or wine.get('bin') or '(none)'} is missing; "
                    f"using global {fallback.get('name') or fallback.get('bin')}"
                )
                wine = fallback
        wine_type = wine.get("type") if isinstance(wine, dict) else None
        wine_bin = wine.get("bin") if isinstance(wine, dict) else None
        wine_name = wine.get("name") if isinstance(wine, dict) else None
        prefix = normalized_abs(config.get("winePrefix") or settings.get("winePrefix"))

        def setting(key, default=None):
            value = config.get(key)
            return settings.get(key, default) if value is None else value

        # User environment variables first, so prefix/runner settings win.
        for item in config.get("enviromentOptions") or settings.get("enviromentOptions") or []:
            if isinstance(item, dict):
                key, value = item.get("key"), item.get("value")
            elif isinstance(item, str) and "=" in item:
                key, value = item.split("=", 1)
            else:
                continue
            if key:
                env_set(env, str(key).strip(), expand(value, {"GAMEDIR": install_dir or ""}))

        runner_label = "system Wine"
        if wine_type == "proton" and wine_bin and not prefix:
            notes.append("Proton runner has no prefix configured; using system Wine")
            kind = "wine"
            runner = system_wine() or "wine"
        elif wine_type == "proton" and wine_bin:
            kind = "proton"
            runner = str(wine_bin)
            runner_label = wine_name or Path(runner).name
            env_set(env, "STEAM_COMPAT_CLIENT_INSTALL_PATH", steam_install_path())
            if prefix:
                env_set(env, "WINEPREFIX", prefix)
                env_set(env, "STEAM_COMPAT_DATA_PATH", prefix)
            env_set(env, "PROTONPATH", str(Path(wine_bin).parent))
            set_proton_game_id(env, store)
        elif wine_type == "wine" and wine_bin:
            kind = "wine"
            runner = str(wine_bin)
            runner_label = wine_name or Path(runner).name
            if prefix:
                env_set(env, "WINEPREFIX", prefix)
            overrides = env_get(env, "WINEDLLOVERRIDES")
            env_set(
                env,
                "WINEDLLOVERRIDES",
                f"{overrides};winemenubuilder.exe=d" if overrides else "winemenubuilder.exe=d",
            )
        else:
            kind = "wine"
            runner = system_wine() or "wine"
            notes.append(
                f"Heroic runner {wine_name or wine_bin or '(none)'} is not usable; using system Wine"
            )
            if prefix:
                env_set(env, "WINEPREFIX", prefix)

        # Heroic's wine/proton toggles.
        esync, fsync = setting("enableEsync"), setting("enableFsync")
        if esync and kind != "proton":
            env_set(env, "WINEESYNC", "1")
        elif not esync and kind == "proton":
            env_set(env, "PROTON_NO_ESYNC", "1")
        if fsync and kind != "proton":
            env_set(env, "WINEFSYNC", "1")
        elif not fsync and kind == "proton":
            env_set(env, "PROTON_NO_FSYNC", "1")
        if setting("enableMsync"):
            env_set(env, "WINEMSYNC", "1")
        if setting("enableWineWayland"):
            if kind == "proton":
                env_set(env, "PROTON_ENABLE_WAYLAND", "1")
                if setting("enableHDR"):
                    env_set(env, "PROTON_ENABLE_HDR", "1")
            else:
                env_set(env, "DISPLAY", "")
                if setting("enableHDR"):
                    env_set(env, "DXVK_HDR", "1")
        if setting("enableWoW64") and kind == "proton":
            env_set(env, "PROTON_USE_WOW64", "1")
        if setting("showFps"):
            env_set(env, "DXVK_HUD", "fps")
        if setting("enableDXVKFpsLimit") and setting("DXVKFpsCap"):
            env_set(env, "DXVK_FRAME_RATE", setting("DXVKFpsCap"))

        if setting("showMangohud") and shutil.which("mangohud"):
            wrappers.append(["mangohud"])

        for item in config.get("wrapperOptions") or settings.get("wrapperOptions") or []:
            if isinstance(item, dict):
                exe = item.get("exe")
                args = item.get("args") or ""
                if exe:
                    wrappers.append([str(exe), *shlex.split(str(args))])
            elif isinstance(item, str) and item.strip():
                wrappers.append(shlex.split(item))

        params = str(info.get("launch_parameters") or "")
        args = shlex.split(params) if params else []
        workdir = install_dir if install_dir and os.path.isdir(install_dir) else (
            str(Path(game_exe).parent) if game_exe else str(HOME)
        )

        title = info.get("title") or app_name
        label = f'Heroic ({store}) "{title}"'
        if wine_name:
            label += f" [{wine_name}]"

        launches.append(
            Launch(
                source="heroic",
                label=label,
                kind=kind,
                runner=runner,
                prefix=prefix,
                workdir=workdir,
                env=env,
                wrappers=wrappers,
                args=args,
                notes=notes,
                store=f"heroic/{store}",
                title=title,
                runner_label=runner_label,
                game_exe=game_exe,
                install_dir=install_dir,
                app_name=app_name,
            )
        )

    return launches


def heroic_store_name(launch: Launch) -> str | None:
    prefix = "heroic/"
    if launch.source == "heroic" and launch.store.startswith(prefix):
        return launch.store[len(prefix):]
    return None


def remove_heroic_installed(store: str, app_name: str) -> bool:
    """Remove an app from the installed-games file Heroic reads for a store."""
    path = HEROIC_STORE_INSTALLED.get(store)
    if path is None:
        return False
    data = load_json(path)
    if data is None:
        return False

    def without(records: list) -> list:
        return [
            record
            for record in records
            if not (isinstance(record, dict) and heroic_app_name(record) == app_name)
        ]

    removed = False
    if store == "epic":
        if isinstance(data, dict) and app_name in data:
            del data[app_name]
            removed = True
    elif isinstance(data, list):
        kept = without(data)
        if len(kept) != len(data):
            data = kept
            removed = True
    elif isinstance(data, dict):
        # GOG and Zoom keep their electron-store list under "installed";
        # sideloaded games live under "games".
        key = "games" if store == "sideload" else "installed"
        records = data.get(key)
        if isinstance(records, list):
            kept = without(records)
            if len(kept) != len(records):
                data[key] = kept
                removed = True
        elif app_name in data:
            del data[app_name]
            removed = True

    if removed:
        save_json(path, data)
    return removed


def hide_heroic_game(app_name: str, title: str) -> None:
    data = load_json(HEROIC_HIDDEN_CONFIG)
    if data is None:
        if HEROIC_HIDDEN_CONFIG.exists():
            die(f"cannot read {HEROIC_HIDDEN_CONFIG}")
        data = {}
    if not isinstance(data, dict):
        die(f"cannot update {HEROIC_HIDDEN_CONFIG}")

    games = data.get("games")
    if not isinstance(games, dict):
        games = {}
        data["games"] = games
    hidden = games.get("hidden")
    if not isinstance(hidden, list):
        hidden = []
        games["hidden"] = hidden
    hidden[:] = [
        entry
        for entry in hidden
        if not (isinstance(entry, dict) and str(entry.get("appName")) == app_name)
    ]
    hidden.append({"appName": app_name, "title": title})
    save_json(HEROIC_HIDDEN_CONFIG, data)


def removable_install_dir(
    launch: Launch, launches: list[Launch], settings: dict
) -> str | None:
    """Return the game directory if deleting it cannot take unrelated data."""
    install_dir = launch.install_dir
    if not install_dir or not os.path.isdir(install_dir) or os.path.islink(install_dir):
        return None
    real = os.path.realpath(install_dir)
    home = os.path.realpath(HOME)
    if real == os.path.realpath("/") or real == home:
        return None
    try:
        if os.path.commonpath([home, real]) == real:
            return None  # The install directory contains the home directory.
    except ValueError:
        pass
    default_install = settings.get("defaultInstallPath")
    if default_install and same_path(real, default_install):
        return None
    for other in launches:
        if other is launch or not other.install_dir:
            continue
        other_real = os.path.realpath(other.install_dir)
        if other_real == real:
            continue
        if under(other_real, real):
            return None  # Another installed game lives below this directory.
    return real


def removable_prefix(
    launch: Launch, launches: list[Launch], settings: dict
) -> str | None:
    """Return the Wine prefix if it is game-specific and safe to delete."""
    prefix = launch.prefix
    if not prefix or not os.path.isdir(prefix) or os.path.islink(prefix):
        return None
    real = os.path.realpath(prefix)
    home = os.path.realpath(HOME)
    if real == os.path.realpath("/") or real == home:
        return None
    try:
        if os.path.commonpath([home, real]) == real:
            return None  # The prefix contains the home directory.
    except ValueError:
        pass

    if (
        launch.install_dir
        and not same_path(launch.install_dir, real)
        and under(launch.install_dir, real)
    ):
        return None  # The prefix contains the game itself.

    for other in launches:
        if other is launch:
            continue
        if other.prefix and same_path(other.prefix, real):
            return None  # Shared with another game.
        if other.install_dir and under(other.install_dir, real) and not same_path(other.install_dir, real):
            return None

    for key in ("defaultInstallPath", "defaultWinePrefix", "winePrefix", "sharedWinePrefix"):
        value = settings.get(key)
        if value and same_path(value, real):
            return None

    heroic_prefixes = HOME / "Games" / "Heroic" / "Prefixes"
    for protected in (
        heroic_prefixes / "default",
        heroic_prefixes / "shared",
    ):
        if same_path(protected, real):
            return None

    roots = (
        launch.install_dir,
        settings.get("defaultInstallPath"),
        settings.get("defaultWinePrefix"),
        str(heroic_prefixes),
    )
    if not any(root and under(real, root) for root in roots):
        return None  # Not inside a game or the Heroic prefix tree.

    try:
        entries = os.listdir(real)
    except OSError:
        return None
    if entries and not (
        os.path.isdir(real + "/drive_c") or os.path.isdir(real + "/pfx")
    ):
        return None
    return real


def remove_heroic_settings(app_name: str, store: str) -> list[str]:
    failures: list[str] = []
    paths = [
        HEROIC_DIR / "GamesConfig" / f"{app_name}.json",
        HEROIC_DIR / "GamesConfig" / f"{app_name}.log",
        HEROIC_DIR / "GamesConfig" / f"{app_name}-lastPlay.log",
        HEROIC_DIR / "fixes" / f"{app_name}-{store}.json",
    ]
    for path in paths:
        try:
            path.unlink(missing_ok=True)
        except OSError as error:
            failures.append(f"{path}: {error}")
    return failures


def heroic_running() -> bool:
    try:
        entries = Path("/proc").iterdir()
    except OSError:
        return False
    for entry in entries:
        if not entry.name.isdigit():
            continue
        try:
            name = (entry / "comm").read_text(encoding="utf-8").strip().casefold()
        except OSError:
            continue
        if name in {"heroic", "heroic-games-launcher"}:
            return True
    return False


def remove_heroic_game(launch: Launch, launches: list[Launch], options) -> int:
    store = heroic_store_name(launch)
    if store is None:
        die("--rm only supports Heroic games")
    app_name = launch.app_name
    if not app_name:
        die("cannot determine the Heroic app name for this game")

    settings = heroic_settings()
    install_dir = removable_install_dir(launch, launches, settings)
    prefix = removable_prefix(launch, launches, settings) if options.remove_prefix else None

    action = "would uninstall" if options.dry_run else "uninstalling"
    print(f'wine.game: {action} {launch.store} "{launch.title}"', file=sys.stderr)
    if launch.install_dir:
        if install_dir:
            print(f"  remove:   {install_dir}", file=sys.stderr)
        elif os.path.exists(launch.install_dir):
            print(
                f"  keep:     {launch.install_dir} (not safe to delete; remove it manually)",
                file=sys.stderr,
            )
    if options.remove_prefix:
        if prefix:
            print(f"  prefix:   remove {prefix}", file=sys.stderr)
        elif launch.prefix:
            print(f"  prefix:   keep {launch.prefix} (shared or not game-specific)", file=sys.stderr)
    if options.remove_settings:
        print("  settings: remove Heroic GamesConfig entries and fixes file", file=sys.stderr)
    print(
        f"  installed: remove {app_name} from {HEROIC_STORE_INSTALLED[store]}",
        file=sys.stderr,
    )
    print(
        f"  hidden:   add {app_name} to {HEROIC_HIDDEN_CONFIG}",
        file=sys.stderr,
    )
    if heroic_running() and not options.dry_run:
        print(
            "wine.game: Heroic is running; restart it to see the library changes",
            file=sys.stderr,
        )

    if options.dry_run:
        print("wine.game: dry run; nothing removed", file=sys.stderr)
        return 0

    failures: list[str] = []
    if install_dir:
        try:
            shutil.rmtree(install_dir)
        except OSError as error:
            failures.append(f"{install_dir}: {error}")
    if prefix and os.path.isdir(prefix):
        try:
            shutil.rmtree(prefix)
        except OSError as error:
            failures.append(f"{prefix}: {error}")
    if failures:
        for failure in failures:
            print(f"wine.game: could not remove {failure}", file=sys.stderr)
        print(
            "wine.game: keeping the Heroic entry so the game can be retried",
            file=sys.stderr,
        )
        return 1

    if options.remove_settings:
        failures.extend(remove_heroic_settings(app_name, store))
    if not remove_heroic_installed(store, app_name):
        print(
            f"wine.game: no installed entry for {app_name} in {HEROIC_STORE_INSTALLED[store]}",
            file=sys.stderr,
        )
    hide_heroic_game(app_name, launch.title)

    if failures:
        for failure in failures:
            print(f"wine.game: could not remove {failure}", file=sys.stderr)
        return 1
    return 0


# --------------------------------------------------------------------------
# Lutris
# --------------------------------------------------------------------------


def lutris_rows():
    database = LUTRIS_DATA / "pga.db"
    if not database.is_file():
        return []
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
        connection.row_factory = sqlite3.Row
        rows = connection.execute(
            "select id, name, slug, runner, directory, configpath, executable, "
            "service, service_id "
            "from games where installed = 1"
        ).fetchall()
        connection.close()
        return rows
    except sqlite3.Error:
        return []


def lutris_config_path(configpath: str | None) -> Path | None:
    if not configpath:
        return None
    base = LUTRIS_CONFIG / "games" / configpath
    for candidate in (base, base.with_suffix(".yml"), Path(f"{base}.yml")):
        if candidate.is_file():
            return candidate
    return None


def lutris_candidates() -> list[Launch]:
    launches: list[Launch] = []

    for row in lutris_rows():
        game = dict(row)
        config = load_yaml(lutris_config_path(game.get("configpath"))) or {}
        game_cfg = config.get("game") if isinstance(config.get("game"), dict) else {}
        system_cfg = config.get("system") if isinstance(config.get("system"), dict) else {}
        wine_cfg = config.get("wine") if isinstance(config.get("wine"), dict) else {}

        directory = game.get("directory") or ""
        prefix = normalized_abs(game_cfg.get("prefix"), directory) or directory or None
        game_exe = normalized_abs(game_cfg.get("exe") or game.get("executable"), prefix or directory)
        if not game_exe and not directory:
            continue

        runner_name = (game.get("runner") or "").lower()
        env: dict[str, str] = {}
        notes: list[str] = []
        wrappers: list[list[str]] = []

        extra = {
            "GAMEDIR": directory or prefix or "",
            "USER": os.environ.get("USER", ""),
        }
        for key, value in (system_cfg.get("env") or {}).items():
            if key:
                env_set(env, str(key), expand(value, extra))
        for key, value in (game_cfg.get("env") or {}).items():
            if key:
                env_set(env, str(key), expand(value, extra))

        if runner_name == "linux":
            kind = "native"
            runner = game_exe or ""
            runner_label = "native"
            prefix = None
            proton_dir = None
        else:
            kind = "wine"
            version = wine_cfg.get("version")
            resolved_runner = runner_bin_from_version(version)
            proton_dir = lutris_proton_dir(version)
            runner = resolved_runner or system_wine() or "wine"
            runner_label = version if resolved_runner else "system Wine"
            if version and not resolved_runner:
                notes.append(f"Lutris Wine runner {version} not found; using system Wine")

            normalized_prefix = normalized_abs(prefix, directory) if prefix else None
            if normalized_prefix:
                env_set(env, "WINEPREFIX", normalized_prefix)
            arch = game_cfg.get("arch") or wine_cfg.get("arch")
            if arch:
                env_set(env, "WINEARCH", arch)
            overrides = wine_cfg.get("overrides")
            if isinstance(overrides, dict) and overrides:
                env_set(
                    env,
                    "WINEDLLOVERRIDES",
                    ";".join(f"{dll}={str(val).replace(' ', '')}" for dll, val in overrides.items()),
                )
            if "esync" in wine_cfg:
                env_set(env, "WINEESYNC", "1" if wine_cfg.get("esync") else "0")
            if "fsync" in wine_cfg:
                env_set(env, "WINEFSYNC", "1" if wine_cfg.get("fsync") else "0")

            if wine_cfg.get("dxvk"):
                env_set(env, "WINE_USE_DXVK", "1")

        prefix_command = system_cfg.get("prefix_command")
        if isinstance(prefix_command, str) and prefix_command.strip():
            wrappers.append([expand(part, extra) for part in shlex.split(prefix_command)])

        raw_args = game_cfg.get("args")
        args = [expand(part, extra) for part in shlex.split(str(raw_args))] if raw_args else []

        title = game.get("name") or game.get("slug") or str(game.get("id"))
        label = f'Lutris "{title}"'
        if wine_cfg.get("version"):
            label += f" [{wine_cfg.get('version')}]"

        launches.append(
            Launch(
                source="lutris",
                label=label,
                kind=kind,
                runner=runner,
                prefix=prefix,
                workdir=directory if directory and os.path.isdir(directory) else (
                    str(Path(game_exe).parent) if game_exe else str(HOME)
                ),
                env=env,
                wrappers=wrappers,
                args=args,
                notes=notes,
                store="lutris",
                title=title,
                runner_label=runner_label,
                game_exe=game_exe,
                install_dir=directory or prefix,
                proton_dir=proton_dir,
                store_service=str(game.get("service") or ""),
                service_id=str(game.get("service_id") or ""),
            )
        )

    return launches


# --------------------------------------------------------------------------
# Selection and execution
# --------------------------------------------------------------------------


def score_launch(launch: Launch, exe: str) -> tuple[int, int] | None:
    if same_path(launch.game_exe, exe):
        return (3, len(os.path.realpath(launch.install_dir or "")))
    if under(exe, launch.install_dir):
        return (2, len(os.path.realpath(launch.install_dir)))
    return None


def default_launch(exe: str) -> Launch:
    notes: list[str] = []
    prefix = os.environ.get("WINEPREFIX")
    if prefix:
        notes.append("using WINEPREFIX from the environment")
    else:
        marker = "/drive_c/"
        posix = exe.replace("\\", "/")
        if marker in posix:
            prefix = posix.split(marker, 1)[0]
            notes.append(f"prefix inferred from {marker} path")

    env: dict[str, str] = {}
    if prefix:
        env_set(env, "WINEPREFIX", prefix)

    return Launch(
        source="default",
        label="no launcher config found",
        kind="wine",
        runner=system_wine() or "wine",
        prefix=prefix,
        workdir=str(Path(exe).parent),
        env=env,
        notes=notes,
        score=(0, 0),
        store="system",
        title=Path(exe).stem,
        runner_label="system Wine",
        game_exe=exe,
        install_dir=str(Path(exe).parent),
    )


def collect_launches() -> list[Launch]:
    launches = heroic_candidates() + lutris_candidates()
    return launches


def find_launch(launches: list[Launch], exe: str) -> Launch:
    best: Launch | None = None
    best_score = (0, 0)
    for launch in launches:
        score = score_launch(launch, exe)
        if score is None:
            continue
        # Prefer exact executable matches and the most specific install dir.
        if score > best_score:
            best, best_score = launch, score
        elif score == best_score and best is not None:
            # Deterministic tie-break: Heroic before Lutris.
            if launch.source == "heroic" and best.source != "heroic":
                best = launch
    if best is None:
        best = default_launch(exe)
    best.score = best_score
    return best


def resolve_executable(raw: str, launches: list[Launch]) -> str:
    candidate = Path(expand(raw)).expanduser()
    if candidate.is_file():
        return str(candidate.resolve())
    if not candidate.is_absolute():
        local = Path.cwd() / candidate
        if local.is_file():
            return str(local.resolve())

    # Accept a bare executable name when it uniquely identifies a known game.
    name = candidate.name.casefold()

    def pick(matches: list[str]) -> str | None:
        unique = sorted(set(matches))
        if len(unique) > 1:
            die("ambiguous executable name; use a full path:\n  " + "\n  ".join(unique))
        return unique[0] if unique else None

    exact = pick([
        launch.game_exe
        for launch in launches
        if launch.game_exe and Path(launch.game_exe).name.casefold() == name
    ])
    if exact:
        return exact

    # Fall back to a substring of the title/store/path when it uniquely
    # identifies a game, so "wine.game sleeper" works for "Citizen Sleeper".
    needles = {name}
    if str(candidate).casefold() != name:
        needles.add(str(candidate).casefold())
    fuzzy: dict[str, str] = {}
    for launch in launches:
        if not launch.game_exe:
            continue
        fields = (launch.title, launch.store, launch.game_exe, launch.label)
        if any(needle in (value or "").casefold() for needle in needles for value in fields):
            fuzzy.setdefault(os.path.realpath(launch.game_exe), launch.game_exe)
    if len(fuzzy) == 1:
        return next(iter(fuzzy.values()))
    if len(fuzzy) > 1:
        die(f"ambiguous game name {raw!r}; use a full path or --list:\n  " + "\n  ".join(sorted(fuzzy.values())))
    die(f"executable not found: {raw}")


def list_games(launches: list[Launch], pattern: str | None = None) -> int:
    entries = [launch for launch in launches if launch.game_exe or launch.install_dir]
    if pattern:
        needle = pattern.casefold()
        entries = [
            launch
            for launch in entries
            if needle in launch.store.casefold()
            or needle in launch.title.casefold()
            or needle in (launch.game_exe or "").casefold()
            or needle in launch.label.casefold()
        ]
    entries.sort(key=lambda launch: (0 if launch.source == "heroic" else 1, launch.store, launch.title.casefold()))

    if not entries:
        print("wine.game: no matching games", file=sys.stderr)
        return 0

    headers = ("TYPE", "GAME", "RUNNER", "EXECUTABLE")
    rows = [
        (
            launch.store,
            launch.title,
            launch.runner_label or launch.kind,
            launch.game_exe or (launch.install_dir or "").rstrip("/") + "/",
        )
        for launch in entries
    ]
    widths = [max(len(headers[i]), max(len(row[i]) for row in rows)) for i in range(3)]

    print(f"{headers[0]:<{widths[0]}}  {headers[1]:<{widths[1]}}  {headers[2]:<{widths[2]}}  {headers[3]}")
    for row in rows:
        print(f"{row[0]:<{widths[0]}}  {row[1]:<{widths[1]}}  {row[2]:<{widths[2]}}  {row[3]}")
    return 0


def print_detection(launch: Launch, exe: str, stream=sys.stderr) -> None:
    print(f"wine.game: {launch.label}", file=stream)
    print(f"  executable: {exe}", file=stream)
    print(f"  runner:     {launch.kind} - {launch.runner}", file=stream)
    if launch.prefix:
        print(f"  prefix:     {launch.prefix}", file=stream)
    print(f"  workdir:    {launch.workdir}", file=stream)
    for note in launch.notes:
        print(f"  note:       {note}", file=stream)


def use_umu(launch: Launch) -> None:
    """Run a Lutris Proton game through umu-run instead of Proton's wine binary."""
    if launch.kind != "wine" or not launch.proton_dir:
        return
    if not UMU_RUN:
        launch.notes.append("umu-run not found; using Proton's wine binary (no protonfixes)")
        return
    if env_get(launch.env, "WINEARCH") == "win32":
        die("umu/Proton is not compatible with 32-bit prefixes")
    game_id = (
        env_get(launch.env, "UMU_ID")
        or env_get(launch.env, "GAMEID")
        or lutris_umu_id(launch.store_service, launch.service_id)
    )
    launch.kind = "umu"
    launch.runner = UMU_RUN
    launch.runner_label = f"{launch.runner_label} via umu"
    if not env_get(launch.env, "PROTONPATH"):
        env_set(launch.env, "PROTONPATH", launch.proton_dir)
    env_set(launch.env, "GAMEID", game_id)
    if launch.prefix:
        env_set(launch.env, "WINEPREFIX", launch.prefix)
        launch.notes.append(f"umu uses {os.path.join(launch.prefix, 'pfx')} as the Wine prefix")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="wine.game",
        description="Run a Windows game with its Heroic/Lutris Wine or Proton environment.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  wine.game ~/Games/Heroic/CitizenSleeperXbYLR/'Citizen Sleeper.exe'\n"
            "  wine.game --dry-run 'Citizen Sleeper.exe'\n"
            "  wine.game --list\n"
            "  wine.game --list sleeper\n"
            "  wine.game sleeper\n"
            "  wine.game --rm sleeper\n"
            "  wine.game --rm --dry-run sleeper\n"
            "  wine.game --no-gamemode /games/foo/game.exe --windowed\n"
        ),
    )
    parser.add_argument("-l", "--list", action="store_true", help="list known Heroic/Lutris games")
    parser.add_argument("-n", "--dry-run", action="store_true", help="print command instead of running")
    parser.add_argument("-q", "--quiet", action="store_true", help="suppress detection output")
    parser.add_argument("--rm", action="store_true", help="uninstall the matched Heroic game and hide it in Heroic (keeps prefix and settings)")
    parser.add_argument("--remove-prefix", action="store_true", help="with --rm, also delete the game's Wine prefix")
    parser.add_argument("--remove-settings", action="store_true", help="with --rm, also delete the game's Heroic settings and logs")
    parser.add_argument("--no-gamemode", action="store_true", help="do not use gamemoderun")
    parser.add_argument("--no-umu", action="store_true", help="use Proton's wine binary instead of umu-run for Lutris games")
    parser.add_argument("--prefix", metavar="PATH", help="force the Wine prefix")
    parser.add_argument("--wine", metavar="PATH", help="force a Wine binary")
    parser.add_argument("--proton", metavar="PATH", help="force a Proton script")
    parser.add_argument("exe", nargs="?", help="game executable or unique name/title substring (or a filter with --list)")
    parser.add_argument("game_args", nargs=argparse.REMAINDER, help="arguments passed to the game")
    options = parser.parse_args(argv)

    if (options.remove_prefix or options.remove_settings) and not options.rm:
        parser.error("--remove-prefix and --remove-settings require --rm")
    if options.rm and options.list:
        parser.error("--rm cannot be combined with --list")
    if options.rm and any((options.prefix, options.wine, options.proton, options.no_umu)):
        parser.error("--rm does not use --prefix, --wine, --proton, or --no-umu")

    launches = collect_launches()

    if options.list:
        pattern = " ".join([options.exe, *options.game_args]) if options.exe else None
        return list_games(launches, pattern)

    if not options.exe:
        parser.error("an executable is required (or use --list)")

    exe = resolve_executable(options.exe, launches)
    launch = find_launch(launches, exe)

    if options.rm:
        return remove_heroic_game(launch, launches, options)

    if options.prefix:
        launch.prefix = str(Path(expand(options.prefix)).expanduser())
        data_path = proton_data_path(launch.prefix)
        if launch.kind == "proton":
            env_set(launch.env, "STEAM_COMPAT_DATA_PATH", data_path)
            env_set(launch.env, "WINEPREFIX", data_path)
        else:
            env_set(launch.env, "WINEPREFIX", launch.prefix)
    if options.proton:
        if not launch.prefix:
            die("--proton needs --prefix pointing at a Proton compatdata directory")
        launch.kind = "proton"
        launch.runner = str(Path(expand(options.proton)).expanduser())
        env_set(
            launch.env,
            "STEAM_COMPAT_CLIENT_INSTALL_PATH",
            env_get(launch.env, "STEAM_COMPAT_CLIENT_INSTALL_PATH", steam_install_path()),
        )
        env_set(launch.env, "PROTONPATH", str(Path(launch.runner).parent))
        env_set(launch.env, "STEAM_COMPAT_DATA_PATH", proton_data_path(launch.prefix))
        env_set(launch.env, "WINEPREFIX", launch.prefix)
        set_proton_game_id(launch.env)
    if options.wine:
        launch.kind = "wine"
        launch.proton_dir = None
        launch.runner = str(Path(expand(options.wine)).expanduser())
        if launch.prefix:
            env_set(launch.env, "WINEPREFIX", wine_prefix_path(launch.prefix))

    if launch.kind == "wine" and launch.proton_dir:
        if options.no_umu:
            launch.notes.append("using Proton's wine binary directly (--no-umu)")
        else:
            use_umu(launch)

    if not os.path.isfile(launch.runner):
        # A runner may be a bare command name (system wine fallback).
        resolved = shutil.which(launch.runner)
        if resolved:
            launch.runner = resolved
        else:
            die(f"runner not found: {launch.runner}")

    game_args = list(options.game_args)
    if game_args and game_args[0] == "--":
        game_args = game_args[1:]

    use_gamemode = not options.no_gamemode
    if use_gamemode and not GAMEMODERUN:
        print("wine.game: gamemoderun not found; continuing without it", file=sys.stderr)
        use_gamemode = False

    command = launch.command(exe, game_args, use_gamemode)
    env = launch.full_env()

    if not options.quiet:
        print_detection(launch, exe)

    if not options.dry_run:
        if launch.kind == "proton":
            repair_proton_template(launch.runner)
        elif launch.kind == "umu" and launch.proton_dir:
            repair_proton_template(os.path.join(launch.proton_dir, "proton"))

    if options.dry_run:
        print("wine.game: dry run", file=sys.stderr)
        changed = {
            key: value
            for key, value in env.items()
            if os.environ.get(key) != value
        }
        for key in sorted(changed):
            print(f"  env {key}={shlex.quote(changed[key])}")
        print(f"  cd {shlex.quote(launch.workdir)}")
        print("  " + " ".join(shlex.quote(part) for part in command))
        return 0

    try:
        os.chdir(launch.workdir)
    except OSError as error:
        die(f"cannot enter working directory {launch.workdir}: {error}")

    try:
        os.execvpe(command[0], command, env)
    except OSError as error:
        die(f"failed to run {command[0]}: {error}")
    return 1  # unreachable


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
