#!/usr/bin/env python3
"""Run a command with light-terminal OSC color replies through a PTY."""
import argparse
import errno
import fcntl
from functools import lru_cache
import os
import pty
import re
import select
import shutil
import signal
import sys
import termios
import tty

# ANSI palette, with darker normal colors suitable for a white background.
PALETTE = ('000000', 'aa0000', '008800', '886600', '0000aa', '880088',
           '008888', 'aaaaaa', '555555', 'ff5555', '55aa55', 'aaaa00',
           '5555ff', 'aa55aa', '55aaaa', 'ffffff')
QUERY = re.compile(rb'\x1b\](?:(10|11|12);\?|4;(\d{1,3});\?)(?:\x07|\x1b\\)')


def rgb(hex_color):
    return '/'.join(hex_color[i:i + 2] * 2 for i in (0, 2, 4)).encode()


class ColorReplies:
    def __init__(self):
        self.pending = b''

    def feed(self, chunk):
        data = self.pending + chunk
        self.pending = b''
        replies = []

        def replace(match):
            code, index = match.groups()
            if code:
                color = 'ffffff' if code == b'11' else '000000'
                prefix = code
            else:
                i = int(index)
                if i >= len(PALETTE):
                    return match[0]
                color = PALETTE[i]
                prefix = b'4;' + index
            replies.append(b'\x1b]' + prefix + b';rgb:' + rgb(color) + b'\x1b\\')
            return b''

        data = QUERY.sub(replace, data)
        # Only retain an unfinished candidate query; never buffer normal OSC
        # hyperlinks, clipboard sequences, or arbitrary application output.
        start = data.rfind(b'\x1b')
        if start >= 0:
            tail = data[start:]
            if (tail == b'\x1b' or tail == b'\x1b]' or
                re.fullmatch(rb'\x1b\](?:1[012]?|4(?:;\d{0,3})?)(?:;\??)?', tail)):
                self.pending, data = tail, data[:start]
        # A query may end its chunk between ESC and backslash of ST.
        start = data.rfind(b'\x1b]')
        if start >= 0 and self.pending == b'\x1b':
            if re.fullmatch(rb'\x1b\](?:1[012];\?|4;\d{1,3};\?)', data[start:]):
                self.pending, data = data[start:] + self.pending, data[:start]
        return data, b''.join(replies)


# Use fixed xterm indices (16..255), avoiding Screen 4.x's RGB handling and
# the SSH client's configurable ANSI 0..15 colors.
LEVELS = (0, 95, 135, 175, 215, 255)
XTERM = [(16 + 36*r + 6*g + b, (rv, gv, bv))
         for r, rv in enumerate(LEVELS) for g, gv in enumerate(LEVELS)
         for b, bv in enumerate(LEVELS)]
XTERM += [(232+i, (8+10*i,)*3) for i in range(24)]


@lru_cache(maxsize=4096)
def luminance(color):
    def linear(v):
        v /= 255
        return v / 12.92 if v <= .04045 else ((v + .055) / 1.055) ** 2.4
    return sum(w*linear(v) for w, v in zip((.2126, .7152, .0722), color))


def contrast(a, b):
    a, b = sorted((luminance(a), luminance(b)))
    return (b + .05) / (a + .05)


@lru_cache(maxsize=4096)
def nearest(color, background=None):
    candidates = XTERM
    if max(color) - min(color) < 16:
        candidates = [(i, rgb) for i, rgb in candidates if rgb[0] == rgb[1] == rgb[2]]
    if background is not None:
        target = 10 if luminance(background) > .5 else 4.5
        candidates = [(i, rgb) for i, rgb in candidates if contrast(rgb, background) >= target]
        if not candidates:
            candidates = [max(XTERM, key=lambda c: contrast(c[1], background))]
    return min(candidates, key=lambda c: sum((a-b)**2 for a, b in zip(color, c[1])))


class ReadableColors:
    """Keep light backgrounds readable and translate truecolor for Screen 4.x."""
    def __init__(self):
        self.pending = b''
        self.foreground = (0, 0, 0)
        self.background = (255, 255, 255)

    def sgr(self, match):
        values = [int(x) if x else 0 for x in match[1].split(b';')]
        keep = []
        i = 0
        while i < len(values):
            value = values[i]
            if value == 0:
                self.foreground, self.background = (0, 0, 0), (255, 255, 255)
                keep.append(0)
            elif value == 2:
                # Faint text defeats the contrast correction on some hosts.
                pass
            elif value in (39, 49):
                if value == 39: self.foreground = (0, 0, 0)
                else: self.background = (255, 255, 255)
            elif 30 <= value <= 37 or 90 <= value <= 97 or 40 <= value <= 47 or 100 <= value <= 107:
                foreground = 30 <= value <= 37 or 90 <= value <= 97
                base = (30 if value < 90 else 90) if foreground else (40 if value < 100 else 100)
                index = value-base+(8 if base >= 90 else 0)
                color = tuple(bytes.fromhex(PALETTE[index]))
                if foreground: self.foreground = color
                else: self.background = color
            elif value in (38, 48) and i+1 < len(values):
                mode = values[i+1]
                color = None
                if mode == 2 and i+4 < len(values):
                    color = tuple(values[i+2:i+5]); i += 4
                elif mode == 5 and i+2 < len(values):
                    index = values[i+2]; i += 2
                    color = (tuple(bytes.fromhex(PALETTE[index])) if index < 16
                             else dict(XTERM).get(index))
                if color is not None:
                    if value == 38: self.foreground = color
                    else: self.background = color
                else:
                    keep.append(value)
            else:
                keep.append(value)
            i += 1
        bg_index, bg_rgb = nearest(self.background)
        fg_index, _ = nearest(self.foreground, bg_rgb)
        keep += [38, 5, fg_index, 48, 5, bg_index]
        return b'\x1b[' + b';'.join(str(x).encode() for x in keep) + b'm'

    def feed(self, chunk):
        data = self.pending + chunk
        self.pending = b''
        start = data.rfind(b'\x1b')
        if start >= 0 and re.fullmatch(rb'\x1b(?:\[[0-9;]*)?', data[start:]):
            self.pending, data = data[start:], data[:start]
        return re.sub(rb'\x1b\[([0-9;]*)m', self.sgr, data)


def write_all(fd, data):
    while data:
        count = os.write(fd, data)
        data = data[count:]


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description='Run a command with light-terminal color handling.')
    parser.add_argument('command', help='Command to run.')
    parser.add_argument(
        'command_args', nargs=argparse.REMAINDER,
        help='Arguments to pass to the command.')
    args = parser.parse_args(argv)
    executable = shutil.which(args.command)
    if executable is None:
        parser.error(f'{args.command!r} was not found on PATH')
    return [executable, *args.command_args]


def main(argv=None):
    command = parse_args(argv)
    if not (os.isatty(0) and os.isatty(1)) or 'NO_COLOR' in os.environ:
        os.execvp(command[0], command)
    original = termios.tcgetattr(0)
    pid, master = pty.fork()
    if pid == 0:
        # This bridge handles the color probes; preserve Screen identity and
        # TERM for all other capabilities and terminal input conventions.
        os.execvp(command[0], command)

    def resize(*_):
        try:
            size = fcntl.ioctl(0, termios.TIOCGWINSZ, b'\0' * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, size)
        except OSError:
            pass

    def forward(signum, _):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGWINCH, resize)
    for signum in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(signum, forward)
    parser = ColorReplies()
    readable_colors = ReadableColors()
    try:
        tty.setraw(0)
        resize()
        inputs = [0, master]
        while master in inputs:
            readable, _, _ = select.select(inputs, [], [])
            for fd in readable:
                try:
                    data = os.read(fd, 65536)
                except OSError as exc:
                    if fd == master and exc.errno == errno.EIO:
                        data = b''
                    else:
                        raise
                if not data:
                    inputs.remove(fd)
                    if fd == 0:
                        forward(signal.SIGHUP, None)
                    continue
                if fd == 0:
                    write_all(master, data)
                else:
                    output, replies = parser.feed(data)
                    if replies:
                        write_all(master, replies)
                    if output:
                        write_all(1, readable_colors.feed(output))
        if parser.pending:
            write_all(1, parser.pending)
    finally:
        write_all(1, b"\x1b[0m")
        termios.tcsetattr(0, termios.TCSADRAIN, original)
        os.close(master)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == '__main__':
    sys.exit(main())
