#!/usr/bin/env python
import argparse
import sys

import numpy as np


def main():
    parser = argparse.ArgumentParser(description="Fit a polynomial to data via np.polyfit")
    parser.add_argument("-d", "--degree", type=int, default=1, help="Polynomial degree (default: 1)")
    parser.add_argument("-e", "--eval", type=float, nargs="+", metavar="X", help="Evaluate the fit at given x values")
    parser.add_argument("-r", "--round", type=int, default=3, metavar="N", help="Round output to N decimal places")
    parser.add_argument("-w", "--weights", action="store_true", help="Third column on stdin contains weights")
    parser.add_argument("--full", action="store_true", help="Print full poly1d representation")
    args = parser.parse_args()

    data = []
    for line in sys.stdin:
        parts = line.split()
        if not parts:
            continue
        data.append([float(x) for x in parts])

    if not data:
        sys.exit("No data provided")

    data = np.array(data)
    cols = data.shape[1]

    x = np.arange(len(data))
    y = data[:, 0]
    w = None

    if cols >= 2:
        x = data[:, 0]
        y = data[:, 1]
    if cols >= 3 and args.weights:
        w = data[:, 2]

    p = np.polyfit(x, y, args.degree, w=w)

    fmt = f"{{:.{args.round}f}}" if args.round is not None else "{}"

    if args.full:
        print(np.poly1d(p))
    elif args.eval is not None:
        for v in np.atleast_1d(np.polyval(p, args.eval)):
            print(fmt.format(v))
    else:
        for c in p:
            print(fmt.format(c))


if __name__ == "__main__":
    main()
