#!/usr/bin/env python3
# SPDX-License-Identifier: WTFPL

"""Describe a command for interactive use.

``cmd.info`` combines the useful parts of ``type``, ``which``, ``file``, and
``rpm -qf``.  For an executable binary it prints the path, the file type, the
owning package, and the version the command reports.  For a printable script
it prints the path and the script itself instead of executing it.  Fish
functions, builtins, and keywords are shown with their definitions, so it can
stand in for ``type`` without losing shell context.

Package ownership comes from RPM on Fedora and from ``dpkg-query`` under
Termux.

Examples::

    cmd.info git
    cmd.info /home/xk/bin/git-originhead
    cmd.info --which -a python3
    cmd.info --no-version --no-source ls

Safety: scripts are never executed.  A binary is asked for ``--version`` only
when it is a regular, non-setuid, non-setgid, not world-writable file.  The
probe runs without a terminal, without stdin, from ``/``, with a sanitised
environment, in its own session, and with a timeout.  Use ``--no-version`` to
skip version probes entirely.
"""

from __future__ import annotations

import argparse
import logging
import os
import re
import shlex
import signal
import stat
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import TextIO

LOG = logging.getLogger("cmd_info")

MAX_SOURCE_LINES = 60
MAX_VERSION_LEN = 160
VERSION_TIMEOUT = 2.0
RPM_TIMEOUT = 2.0
DPKG_TIMEOUT = 2.0
FISH_TIMEOUT = 3.0

_ESCAPE_SEQUENCE = re.compile(
    r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-_])"
)
_CONTROL_CHAR = re.compile(r"[\x00-\x1f\x7f-\x9f]")
_GO_VERSION = re.compile(r":\s*(go\S+)")


def clean_text(text: str) -> str:
    """Remove terminal escape sequences and control characters from text.

    Parameters
    ----------
    text : str
        Text that may contain terminal escape sequences or control
        characters.

    Returns
    -------
    str
        Printable text with escape sequences and control characters removed.

    Examples
    --------
    >>> clean_text("\\x1b[31mtool\\x1b[0m")
    'tool'
    >>> clean_text("tool\\x07 1.0")
    'tool 1.0'
    """
    return _CONTROL_CHAR.sub("", _ESCAPE_SEQUENCE.sub("", text))


def human_size(size: int) -> str:
    """Format a byte count for humans.

    Parameters
    ----------
    size : int
        Number of bytes.

    Returns
    -------
    str
        Byte count with binary units.

    Examples
    --------
    >>> human_size(1024)
    '1.0 KiB'
    >>> human_size(1536)
    '1.5 KiB'
    """
    if size < 1024:
        return f"{size} B"
    value = float(size)
    for unit in ("KiB", "MiB", "GiB", "TiB", "PiB"):
        value /= 1024.0
        if value < 1024.0 or unit == "PiB":
            return f"{value:.1f} {unit}"
    return f"{size} B"


def split_path(path_value: str) -> list[str]:
    """Split ``$PATH`` into unique absolute directories.

    Relative entries are resolved against the current directory and entries
    that point at the same real directory are dropped, keeping the first one.

    Parameters
    ----------
    path_value : str
        Value of ``$PATH``.

    Returns
    -------
    list[str]
        Directories in lookup order.

    Examples
    --------
    >>> split_path("/a:/b:/a")
    ['/a', '/b']
    """
    directories: list[str] = []
    seen: set[str] = set()
    for entry in path_value.split(os.pathsep):
        if not entry:
            continue
        directory = os.path.abspath(os.path.expanduser(entry))
        real = os.path.realpath(directory)
        if real in seen:
            continue
        seen.add(real)
        directories.append(directory)
    return directories


def find_matches(name: str, path_value: str, *, cwd: str | None = None) -> list[str]:
    """Find executable files for a command name.

    A name containing a path separator is treated as an explicit path and may
    point at a non-executable text file, which is useful for inspecting a
    script.  A bare name is searched in ``$PATH`` and must be executable.

    Parameters
    ----------
    name : str
        Command name or explicit path.
    path_value : str
        Value of ``$PATH``.
    cwd : str | None
        Directory used to resolve relative explicit paths.  ``None`` uses the
        current directory.

    Returns
    -------
    list[str]
        Matching paths in lookup order, deduplicated by real path.

    Examples
    --------
    >>> find_matches("/definitely/not/here", "")
    []
    """
    cwd = cwd or os.getcwd()
    if os.sep in name or (os.altsep is not None and os.altsep in name):
        expanded = os.path.expanduser(name)
        candidate = expanded if os.path.isabs(expanded) else os.path.join(cwd, expanded)
        candidate = os.path.abspath(candidate)
        return [candidate] if os.path.isfile(candidate) else []

    matches: list[str] = []
    seen: set[str] = set()
    for directory in split_path(path_value):
        candidate = os.path.join(directory, name)
        if not os.path.isfile(candidate):
            continue
        if not os.access(candidate, os.X_OK):
            continue
        real = os.path.realpath(candidate)
        if real in seen:
            continue
        seen.add(real)
        matches.append(candidate)
    return matches


@dataclass(frozen=True)
class FileFacts:
    """Filesystem facts about one command candidate.

    Parameters
    ----------
    path : str
        Path as it was found, without resolving symlinks.
    real_path : str
        Symlink-resolved path.
    link_target : str
        Raw symlink target, or an empty string when ``path`` is not a link.
    description : str
        ``file(1)`` description.
    size : int
        File size in bytes.
    mode : int
        ``st_mode``.
    is_text : bool
        Whether the beginning of the file looks printable.
    is_regular : bool
        Whether the file is a regular file.
    is_setuid : bool
        Whether the setuid bit is set.
    is_setgid : bool
        Whether the setgid bit is set.
    is_world_writable : bool
        Whether other users may write the file.
    shebang : str
        First line when it starts with ``#!``.
    interpreter : str
        Interpreter derived from the shebang.
    """

    path: str
    real_path: str
    link_target: str
    description: str
    size: int
    mode: int
    is_text: bool
    is_regular: bool
    is_setuid: bool
    is_setgid: bool
    is_world_writable: bool
    shebang: str
    interpreter: str


@dataclass(frozen=True)
class Origin:
    """Where a command came from.

    Parameters
    ----------
    kind : str
        ``rpm``, ``uv``, ``cargo``, ``user``, ``user-install``, or empty.
    label : str
        Human-readable origin, such as ``coreutils 9.7-1``.
    """

    kind: str
    label: str


@dataclass(frozen=True)
