[Unit]
Description=Fish screen and command shortcuts
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/fish-screen-shortcuts
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
