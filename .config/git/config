# This is Git's per-user configuration file.
[user]
	name = Jacob Chapman
	email = 7908073+chapmanjacobd@users.noreply.github.com
	signingkey = /home/xk/.ssh/id_ed25519.pub
[push]
	default = upstream
	autosetupremote = true
	followtags = true
    #useForceIfIncludes = true
[core]
	pager = delta --syntax-theme GitHub --max-line-length 1024  # --keep-plus-minus-markers
	excludesfile = /home/xk/.config/git/ignore
	preloadindex = true
	fscache = true
	eol = lf
	autocrlf = false
	logallrefupdates = true
	attributesfile = /home/xk/.config/git/attributes
	hookspath = /dev/null
	commitgraph = true
	multipackindex = true
[transfer]
	fsckobjects = true
[fetch]
	fsckobjects = true
	writecommitgraph = true
[receive]
	fsckobjects = true
[init]
	defaultbranch = main
[pull]
	rebase = merges
[rebase]
	autostash = true
	autosquash = true
	missingcommitscheck = warn
[rerere]
	enabled = true
	autoupdate = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = cache
[help]
	autocorrect = prompt
[log]
	date = relative-local
[advice]
	skippedcherrypicks = false
[branch]
	sort = -committerdate
[tag]
	sort = -taggerdate
[commit]
	template = ~/.config/git/message
	verbose = true
	gpgsign = true
[receive "fsck"]
	zeropaddedfilemode = warn
[fetch "fsck"]
	zeropaddedfilemode = ignore
[gpg]
	format = ssh
[interactive]
	difffilter = delta --syntax-theme GitHub --color-only --features=interactive
[diff]
	algorithm = histogram
	indentheuristic = true
	tool = kdiff3
	colormoved = zebra
	context = 5
	mnemonicprefix = true
	guitool = kdiff3
	colormovedws = ignore-all-space
[delta]
	navigate = true
[diff "sqlite3"]
	binary = true
	textconv = "echo .dump | sqlite3"
[merge]
	autostash = true
	conflictstyle = zdiff3
	summary = true
	diffstat = true
	log = 50
	tool = kdiff3
	guitool = kdiff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[color]
	ui = auto
[color "diff-highlight"]
	oldnormal = red bold
	oldhighlight = red bold 52
	newnormal = green bold
	newhighlight = green bold 22
[color "diff"]
	meta = yellow
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "grep"]
	match = red normal bold
	filename = magenta
	linenumber = green
	column = green
	separator = cyan
[difftool]
	prompt = false
[difftool "kdiff3"]
	trustexitcode = false
[mergetool "kdiff3"]
	trustexitcode = false
[pack]
	writebitmaplookup = true
[maintenance]
	repo = /home/xk
	repo = /home/xk/github/xk/mc
[maintenance "prefetch"]
	enabled = false
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
