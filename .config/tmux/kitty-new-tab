#!/bin/bash

set -eu

listen_on=${KITTY_LISTEN_ON:?Kitty remote-control socket is unavailable}

kitty_remote_control() {
    kitty @ --to "$listen_on" "$@"
}

window_match=state:focused
if [ -n "${KITTY_WINDOW_ID:-}" ]; then
    window_match="id:$KITTY_WINDOW_ID"
fi
window_json=$(kitty_remote_control ls --match "$window_match" --output-format=json)
source_pid=$(
    printf '%s' "$window_json" |
        jq -r '
            .[].tabs[].windows[]
            | .pid
        ' |
        head -n 1
)

pane_id=
if [ -n "$source_pid" ] && [ -e "/proc/$source_pid/fd/0" ]; then
    source_tty=$(readlink "/proc/$source_pid/fd/0" 2>/dev/null || true)
    tab=$(printf '\t')
    tmux_clients=$(tmux list-clients -F "#{client_tty}${tab}#{pane_id}" 2>/dev/null || true)
    pane_id=$(
        printf '%s\n' "$tmux_clients" |
            awk -F '\t' -v tty="$source_tty" '$1 == tty { print $2; exit }'
    )
fi

if [ -n "$pane_id" ]; then
    cwd=$(tmux display-message -p -t "$pane_id" '#{pane_current_path}')
else
    cwd=$(pwd)
fi

kitty_remote_control launch \
    --type=tab \
    --location=neighbor \
    --cwd "$cwd" \
    --no-response
