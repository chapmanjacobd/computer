{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["/home/xk/.config/opencode/plugins/osc133"],
  "scroll": {
    "acceleration": false
  },
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "animations": false,
  "mouse": true,
  "terminal": {
    "copy": "manual"
  },
  "tabs": {
    "layout": "horizontal",
    "mode": "off",
    "indicators": "status",
    "scope": "cwd"
  },
  "session": {
    "thinking": "show",
    "sidebar": "auto",
    "grouping": "auto",
    "scrollbar": false,
    "tps": false
  },
  "theme": {
    "name": "solarized-mini",
    "mode": "light"
  },
  "mini": {
    "work_spinner": "block-soft-sweep",
    "thinking": "hide",
    "tools": "hide",
    "shell_output": "show",
    "turn_summary": "hide",
    "footer": "show",
    "mono": true,
    "splash": "hide"
  }
}
