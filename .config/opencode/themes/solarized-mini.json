{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "#000000",
      "muted": "#555555",
      "faint": "#808080",
      "action": {
        "primary": {
          "base": "#000000",
          "$disabled": "#999999",
          "$focused": "#000000",
          "$selected": "#000000"
        },
        "secondary": {
          "base": "#555555",
          "$hovered": "#000000"
        },
        "destructive": {
          "base": "#ff0000",
          "$disabled": "#999999"
        }
      },
      "formfield": {
        "base": "#000000",
        "$hovered": "#000000",
        "$focused": "#000000",
        "$pressed": "#000000",
        "$disabled": "#999999",
        "$selected": "#000000"
      },
      "feedback": {
        "error": {
          "base": "#ff0000"
        },
        "warning": {
          "base": "#b3a06d"
        },
        "success": {
          "base": "#008000"
        },
        "info": {
          "base": "#005f5f"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "transparent",
        "high": "transparent",
        "max": "transparent"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "transparent",
          "$focused": "transparent",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "transparent"
        }
      },
      "formfield": {
        "base": "transparent"
      },
      "feedback": {
        "error": {
          "base": "transparent"
        },
        "warning": {
          "base": "transparent"
        },
        "success": {
          "base": "transparent"
        },
        "info": {
          "base": "transparent"
        }
      }
    },
    "border": {
      "base": "#999999"
    },
    "scrollbar": {
      "base": "#999999"
    },
    "diff": {
      "text": {
        "added": "#008000",
        "removed": "#ff0000",
        "context": "#555555",
        "hunkHeader": "#005fff"
      },
      "background": {
        "added": "transparent",
        "removed": "transparent",
        "context": "transparent"
      },
      "highlight": {
        "added": "#008000",
        "removed": "#ff0000"
      },
      "lineNumber": {
        "text": "#808080",
        "background": {
          "added": "transparent",
          "removed": "transparent"
        }
      }
    },
    "syntax": {
      "comment": "#870000",
      "keyword": "#005fff",
      "function": "#875f87",
      "variable": "#080808",
      "string": "#555555",
      "number": "#85377f",
      "type": "#b3a06d",
      "operator": "#00a6b2",
      "punctuation": "#080808"
    },
    "markdown": {
      "text": "#000000",
      "heading": "#005fff",
      "link": "#00a6b2",
      "linkText": "#875f87",
      "code": "#005f5f",
      "blockQuote": "#555555",
      "emphasis": "#b3a06d",
      "strong": "#875f87",
      "horizontalRule": "#999999",
      "listItem": "#005fff",
      "listEnumeration": "#00a6b2",
      "image": "#00a6b2",
      "imageText": "#875f87",
      "codeBlock": "#080808"
    },
    "@dialog": {
      "background": {
        "base": "transparent",
        "action": {
          "primary": {
            "$hovered": "transparent"
          },
          "secondary": {
            "$hovered": "transparent"
          }
        }
      }
    }
  },
  "light": {
