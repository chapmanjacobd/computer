{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "#000000",
      "muted": "#586e75",
      "faint": "#657b83",
      "action": {
        "primary": {
          "base": "#000000",
          "$disabled": "#93a1a1",
          "$focused": "#000000",
          "$selected": "#000000"
        },
        "secondary": {
          "base": "#586e75",
          "$hovered": "#000000"
        },
        "destructive": {
          "base": "#dc322f",
          "$disabled": "#93a1a1"
        }
      },
      "formfield": {
        "base": "#000000",
        "$hovered": "#000000",
        "$focused": "#000000",
        "$pressed": "#000000",
        "$disabled": "#93a1a1",
        "$selected": "#000000"
      },
      "feedback": {
        "error": {
          "base": "#dc322f"
        },
        "warning": {
          "base": "#b58900"
        },
        "success": {
          "base": "#859900"
        },
        "info": {
          "base": "#268bd2"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "transparent",
        "high": "transparent",
        "max": "transparent"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "transparent",
          "$focused": "transparent",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "transparent"
        }
      },
      "formfield": {
        "base": "transparent"
      },
      "feedback": {
        "error": {
          "base": "transparent"
        },
        "warning": {
          "base": "transparent"
        },
        "success": {
          "base": "transparent"
        },
        "info": {
          "base": "transparent"
        }
      }
    },
    "border": {
      "base": "#d5d5d5"
    },
    "scrollbar": {
      "base": "#c0c0c0"
    },
    "diff": {
      "text": {
        "added": "#859900",
        "removed": "#dc322f",
        "context": "#657b83",
        "hunkHeader": "#268bd2"
      },
      "background": {
        "added": "transparent",
        "removed": "transparent",
        "context": "transparent"
      },
      "highlight": {
        "added": "#859900",
        "removed": "#dc322f"
      },
      "lineNumber": {
        "text": "#93a1a1",
        "background": {
          "added": "transparent",
          "removed": "transparent"
        }
      }
    },
    "syntax": {
      "comment": "#93a1a1",
      "keyword": "#859900",
      "function": "#268bd2",
      "variable": "#268bd2",
      "string": "#2aa198",
      "number": "#d33682",
      "type": "#b58900",
      "operator": "#859900",
      "punctuation": "#000000"
    },
    "markdown": {
      "text": "#000000",
      "heading": "#268bd2",
      "link": "#2aa198",
      "linkText": "#6c71c4",
      "code": "#859900",
      "blockQuote": "#657b83",
      "emphasis": "#b58900",
      "strong": "#cb4b16",
      "horizontalRule": "#93a1a1",
      "listItem": "#268bd2",
      "listEnumeration": "#2aa198",
      "image": "#2aa198",
      "imageText": "#6c71c4",
      "codeBlock": "#000000"
    },
    "@dialog": {
      "background": {
        "base": "transparent",
        "action": {
          "primary": {
            "$hovered": "transparent"
          },
          "secondary": {
            "$hovered": "transparent"
          }
        }
      }
    }
  },
  "light": {
